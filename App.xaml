<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Iris.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///DesignSystem/Themes/Tokens.xaml" />
                <ResourceDictionary Source="ms-appx:///DesignSystem/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Iris is dark-only; system accent becomes coral so built-in controls (ProgressRing, Slider, focus) match.  -->
            <Color x:Key="SystemAccentColor">#FFFF7A59</Color>
            <Color x:Key="SystemAccentColorLight1">#FFFF8C70</Color>
            <Color x:Key="SystemAccentColorLight2">#FFFF7A59</Color>
            <Color x:Key="SystemAccentColorLight3">#FFFFB09C</Color>
            <Color x:Key="SystemAccentColorDark1">#FFE5684A</Color>
            <Color x:Key="SystemAccentColorDark2">#FFC9553A</Color>
            <Color x:Key="SystemAccentColorDark3">#FFA8432C</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
