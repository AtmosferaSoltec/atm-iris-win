<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Iris.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Iris.DesignSystem.Controls"
    xmlns:connection="using:Iris.Features.Connection"
    Title="Iris">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <!--  The ambient background sits over Mica; each screen draws its own title-bar row. The splash covers it all at launch.  -->
    <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Invoked="OnConnectionAccelerator" Key="F12" Modifiers="Control,Shift" />
        </Grid.KeyboardAccelerators>
        <controls:IrisBackground />
        <Frame x:Name="RootFrame" />

        <!--  Conexión (Ctrl+Shift+F12): mode, API address, offline switch  -->
        <connection:ConnectionSheet x:Name="ConnectionDialog" />
        <controls:IrisSplash x:Name="Splash" Finished="OnSplashFinished" />
    </Grid>
</Window>
