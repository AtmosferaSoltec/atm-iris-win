<?xml version="1.0" encoding="utf-8"?>
<!--  Nueva versión (docs/plans/12): obligatoria, sin botón de cerrar; Esc y el fondo no hacen nada (no hay CloseCommand).  -->
<UserControl
    x:Class="Iris.Features.Updates.UpdateGateSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Iris.DesignSystem.Controls"
    IsTabStop="False">

    <controls:IrisModal IsOpen="{x:Bind ViewModel.IsOpen, Mode=OneWay}" PanelWidth="{StaticResource IrisFormModalWidth}">
        <StackPanel Padding="{StaticResource IrisPaddingXl}" Spacing="{StaticResource IrisSpacingLg}">
            <StackPanel Spacing="{StaticResource IrisSpacingXs}">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource IrisTitleTextStyle}"
                    Text="Hay una nueva versión de Iris"
                    TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource IrisCalloutTextStyle}"
                    Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource IrisCalloutTextStyle}"
                    Text="{x:Bind ViewModel.Required.Notes, Mode=OneWay, FallbackValue=''}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <controls:IrisBanner Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

            <StackPanel Spacing="{StaticResource IrisSpacingXs}" Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay}">
                <ProgressBar Maximum="100" Value="{x:Bind ViewModel.Percent, Mode=OneWay}" />
                <TextBlock Style="{StaticResource IrisCaptionTextStyle}" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
            </StackPanel>

            <Button
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.InstallCommand}"
                Content="Actualizar"
                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                Style="{StaticResource IrisPrimaryButtonStyle}" />
        </StackPanel>
    </controls:IrisModal>
</UserControl>
