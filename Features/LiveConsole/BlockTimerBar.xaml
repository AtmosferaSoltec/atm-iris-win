<?xml version="1.0" encoding="utf-8"?>
<!--
    Block-timer strip above the workspace (IRIS_SPEC §6.9): not started · running · finished.
    The clock lives only here, never on the TV.
-->
<UserControl
    x:Class="Iris.Features.LiveConsole.BlockTimerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:console="using:Iris.Features.LiveConsole"
    xmlns:controls="using:Iris.DesignSystem.Controls"
    xmlns:design="using:Iris.DesignSystem"
    IsTabStop="False">

    <UserControl.Resources>
        <DataTemplate x:Key="CrumbTemplate" x:DataType="console:BlockCrumb">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <controls:IrisLiveDot Visibility="{x:Bind IsCurrent}" />
                <TextBlock
                    Foreground="{x:Bind console:BlockTimerBar.CrumbBrush(IsCurrent, IsDone)}"
                    Style="{StaticResource IrisCaptionTextStyle}"
                    Text="{x:Bind Name}"
                    TextDecorations="{x:Bind console:BlockTimerBar.Strike(IsSkipped)}" />
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="4"
                    Visibility="{x:Bind IsDone}">
                    <FontIcon
                        FontSize="{StaticResource IrisCaptionFontSize}"
                        Foreground="{x:Bind design:Bind.OverBrush(IsOver)}"
                        Glyph="&#xE73E;"
                        Style="{StaticResource IrisIconStyle}" />
                    <TextBlock
                        Foreground="{x:Bind console:BlockTimerBar.DetailBrush(IsOver)}"
                        Style="{StaticResource IrisNumberTextStyle}"
                        Text="{x:Bind Detail}" />
                </StackPanel>
                <TextBlock
                    Style="{StaticResource IrisCaptionTextStyle}"
                    Text="·"
                    Visibility="{x:Bind design:Bind.Collapsed(IsLast)}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="LeaderItemTemplate" x:DataType="console:LeaderMenuItem">
            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Click="OnLeaderChosen"
                Command="{x:Bind Owner.SetLeaderCommand}"
                CommandParameter="{x:Bind}"
                Padding="12,8"
                Style="{StaticResource IrisPressableButtonStyle}">
                <Grid ColumnSpacing="{StaticResource IrisSpacingSm}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource IrisCalloutEmphasizedTextStyle}" Text="{x:Bind Name}" />
                    <FontIcon
                        Grid.Column="1"
                        FontSize="{StaticResource IrisCaptionFontSize}"
                        Foreground="{StaticResource IrisCoralBrush}"
                        Glyph="&#xE73E;"
                        Style="{StaticResource IrisIconStyle}"
                        Visibility="{x:Bind IsSelected}" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Border Padding="{StaticResource IrisTimerBarPadding}" Style="{StaticResource IrisConsoleSurfaceStyle}">
        <Grid>
            <!--  Not started  -->
            <Grid ColumnSpacing="{StaticResource IrisSpacingLg}" Visibility="{x:Bind ViewModel.IsNotStarted, Mode=OneWay, FallbackValue=Collapsed}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Style="{StaticResource IrisOverlineTextStyle}" Text="BLOQUES" />
                    <TextBlock Style="{StaticResource IrisCalloutEmphasizedTextStyle}" Text="{x:Bind ViewModel.PlanSummary, Mode=OneWay, FallbackValue=''}" />
                </StackPanel>
                <controls:IrisBlockTimeline
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Minutes="{x:Bind ViewModel.PlannedMinutes, Mode=OneWay, FallbackValue={x:Null}}" />
                <Button
                    Grid.Column="2"
                    Width="{StaticResource IrisStartBlocksButtonWidth}"
                    Command="{x:Bind ViewModel.StartBlocksCommand, Mode=OneWay}"
                    Style="{StaticResource IrisPrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="{StaticResource IrisCaptionFontSize}"
                            Glyph="&#xE768;"
                            Style="{StaticResource IrisIconStyle}" />
                        <TextBlock Text="Comenzar" />
                    </StackPanel>
                </Button>
            </Grid>

            <!--  Running  -->
            <StackPanel Spacing="{StaticResource IrisSpacingSm}" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, FallbackValue=Collapsed}">
                <Grid ColumnSpacing="{StaticResource IrisSpacingMd}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:IrisLiveDot />
                            <TextBlock
                                Foreground="{StaticResource IrisTextPrimaryBrush}"
                                Style="{StaticResource IrisOverlineTextStyle}"
                                Text="{x:Bind ViewModel.CurrentName, Mode=OneWay, FallbackValue=''}" />
                        </StackPanel>
                        <Button
                            x:Name="LeaderButton"
                            Padding="0"
                            AutomationProperties.Name="Responsable del bloque"
                            Style="{StaticResource IrisLinkButtonStyle}"
                            ToolTipService.ToolTip="Cambiar responsable">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock FontSize="{StaticResource IrisCaptionFontSize}" Text="{x:Bind ViewModel.CurrentLeaderName, Mode=OneWay, FallbackValue=''}" />
                                <FontIcon
                                    FontSize="10"
                                    Glyph="&#xE70D;"
                                    Style="{StaticResource IrisIconStyle}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout
                                    x:Name="LeaderFlyout"
                                    FlyoutPresenterStyle="{StaticResource IrisFlyoutPresenterStyle}"
                                    Placement="BottomEdgeAlignedLeft">
                                    <ScrollViewer MaxHeight="360">
                                        <ItemsRepeater
                                            MinWidth="220"
                                            ItemTemplate="{StaticResource LeaderItemTemplate}"
                                            ItemsSource="{x:Bind ViewModel.CurrentLeaderOptions, Mode=OneWay, FallbackValue={x:Null}}" />
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="{StaticResource IrisSpacingSm}">
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Tiempo del bloque"
                            Foreground="{x:Bind design:Bind.ClockBrush(ViewModel.CurrentClockState), Mode=OneWay, FallbackValue={x:Null}}"
                            Style="{StaticResource IrisTimerClockTextStyle}"
                            Text="{x:Bind ViewModel.ClockText, Mode=OneWay, FallbackValue=''}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource IrisNumberTextStyle}"
                            Text="{x:Bind ViewModel.PlannedText, Mode=OneWay, FallbackValue=''}" />
                        <Border
                            Padding="{StaticResource IrisChipPadding}"
                            VerticalAlignment="Center"
                            Background="{x:Bind console:BlockTimerBar.DeltaBackground(ViewModel.CurrentClockState), Mode=OneWay, FallbackValue={x:Null}}"
                            CornerRadius="{StaticResource IrisRadiusCapsuleChip}">
                            <TextBlock
                                Foreground="{x:Bind design:Bind.ClockBrush(ViewModel.CurrentClockState), Mode=OneWay, FallbackValue={x:Null}}"
                                Style="{StaticResource IrisNumberTextStyle}"
                                Text="{x:Bind ViewModel.CurrentDeltaText, Mode=OneWay, FallbackValue=''}" />
                        </Border>
                    </StackPanel>

                    <Button
                        Grid.Column="3"
                        Width="{StaticResource IrisNextBlockButtonWidth}"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.GoToNextBlockCommand, Mode=OneWay}"
                        Style="{StaticResource IrisPrimaryButtonStyle}"
                        ToolTipService.ToolTip="Siguiente bloque (Ctrl+→)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.NextButtonText, Mode=OneWay, FallbackValue=''}" />
                            <FontIcon
                                FontSize="{StaticResource IrisCaptionFontSize}"
                                Glyph="&#xE72A;"
                                Style="{StaticResource IrisIconStyle}"
                                Visibility="{x:Bind ViewModel.HasNextBlock, Mode=OneWay, FallbackValue=Collapsed}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Opciones de bloques"
                        Style="{StaticResource IrisIconButtonStyle}"
                        ToolTipService.ToolTip="Opciones de bloques">
                        <FontIcon Glyph="&#xE712;" Style="{StaticResource IrisIconStyle}" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Command="{x:Bind ViewModel.PresentAddBlockCommand, Mode=OneWay}" Text="Agregar bloque…">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE710;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.PresentPendingEditorCommand, Mode=OneWay}" Text="Editar bloques pendientes…">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.SkipNextBlockCommand, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.HasNextBlock, Mode=OneWay, FallbackValue=False}"
                                    Text="Omitir siguiente bloque">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE893;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        Grid.Column="5"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.RequestFinishCommand, Mode=OneWay}"
                        Content="Terminar"
                        Style="{StaticResource IrisPillButtonStyle}"
                        ToolTipService.ToolTip="Terminar el servicio (Ctrl+Enter)" />
                </Grid>

                <Grid Height="{StaticResource IrisProgressBarHeight}">
                    <Border Background="{StaticResource IrisSurfaceRaisedBrush}" CornerRadius="{StaticResource IrisRadiusStripe}" />
                    <ProgressBar
                        MinHeight="0"
                        Height="{StaticResource IrisProgressBarHeight}"
                        AutomationProperties.Name="Avance del bloque"
                        Background="Transparent"
                        CornerRadius="{StaticResource IrisRadiusStripe}"
                        Foreground="{x:Bind design:Bind.ProgressBrush(ViewModel.CurrentClockState), Mode=OneWay, FallbackValue={x:Null}}"
                        Maximum="1"
                        Value="{x:Bind ViewModel.CurrentProgress, Mode=OneWay, FallbackValue=0}" />
                </Grid>

                <ItemsRepeater ItemTemplate="{StaticResource CrumbTemplate}" ItemsSource="{x:Bind ViewModel.Breadcrumbs, Mode=OneWay, FallbackValue={x:Null}}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="{StaticResource IrisSpacingXs}" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <!--  Finished  -->
            <Grid ColumnSpacing="{StaticResource IrisSpacingMd}" Visibility="{x:Bind ViewModel.IsFinished, Mode=OneWay, FallbackValue=Collapsed}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Center"
                    Foreground="{StaticResource IrisSuccessBrush}"
                    Glyph="&#xE930;"
                    Style="{StaticResource IrisIconStyle}" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock Style="{StaticResource IrisCalloutEmphasizedTextStyle}" Text="{x:Bind ViewModel.FinishedSummary, Mode=OneWay, FallbackValue=''}" />
                    <TextBlock
                        Foreground="{StaticResource IrisWarningBrush}"
                        Style="{StaticResource IrisCaptionTextStyle}"
                        Text="Se enviará cuando haya conexión"
                        Visibility="{x:Bind ViewModel.IsRecordPending, Mode=OneWay, FallbackValue=Collapsed}" />
                    <TextBlock
                        Foreground="{StaticResource IrisDangerBrush}"
                        Style="{StaticResource IrisCaptionTextStyle}"
                        Text="{x:Bind ViewModel.RecordError, Mode=OneWay, FallbackValue=''}"
                        Visibility="{x:Bind ViewModel.HasRecordError, Mode=OneWay, FallbackValue=Collapsed}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{StaticResource IrisSpacingSm}">
                    <Button
                        Command="{x:Bind ViewModel.RetrySavingRecordCommand, Mode=OneWay}"
                        Content="Reintentar"
                        Style="{StaticResource IrisPillButtonStyle}"
                        Visibility="{x:Bind ViewModel.HasRecordError, Mode=OneWay, FallbackValue=Collapsed}" />
                    <Button
                        Command="{x:Bind ViewModel.ViewInTimesCommand, Mode=OneWay}"
                        Content="Ver en Tiempos"
                        Style="{StaticResource IrisLinkButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsRecordSaved, Mode=OneWay, FallbackValue=Collapsed}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
