<?xml version="1.0" encoding="utf-8"?>
<!--  Live console (IRIS_SPEC §6.2): top bar in the title bar, SERVICIO + EN VIVO column, workspace.  -->
<Page
    x:Class="Iris.Features.LiveConsole.LiveConsolePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:add="using:Iris.Features.AddToService"
    xmlns:bible="using:Iris.Features.Bible"
    xmlns:console="using:Iris.Features.LiveConsole"
    xmlns:controls="using:Iris.DesignSystem.Controls"
    xmlns:design="using:Iris.DesignSystem"
    xmlns:projection="using:Iris.Shared.Projection"
    xmlns:shell="using:Iris.Shell"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="ServiceRowTemplate" x:DataType="console:ServiceItemViewModel">
            <console:ServiceItemRow Item="{x:Bind}" />
        </DataTemplate>

        <DataTemplate x:Key="SlideCardTemplate" x:DataType="console:SlideCardViewModel">
            <StackPanel Spacing="{StaticResource IrisSpacingXs}">
                <Button
                    AutomationProperties.ItemStatus="{x:Bind console:LiveConsolePage.LiveStatus(IsLive), Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind AccessibleName}"
                    Command="{x:Bind Owner.GoLiveCommand}"
                    CommandParameter="{x:Bind}"
                    Style="{StaticResource IrisPressableButtonStyle}"
                    ToolTipService.ToolTip="Envía esta diapositiva al TV">
                    <Grid CornerRadius="{StaticResource IrisRadiusMd}">
                        <projection:ProjectionCanvas Frame="{x:Bind Frame}" />
                        <Border
                            BorderBrush="{StaticResource IrisStrokeBrush}"
                            BorderThickness="{StaticResource IrisHairline}"
                            CornerRadius="{StaticResource IrisRadiusMd}" />
                        <Border
                            BorderBrush="{StaticResource IrisAccentGradientBrush}"
                            BorderThickness="{StaticResource IrisSelectedCardStroke}"
                            CornerRadius="{StaticResource IrisRadiusMd}"
                            Visibility="{x:Bind IsLive, Mode=OneWay}" />
                    </Grid>
                </Button>
                <TextBlock
                    Style="{StaticResource IrisLabelTextStyle}"
                    Text="{x:Bind Label}"
                    Visibility="{x:Bind HasLabel}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BackgroundSwatchTemplate" x:DataType="console:BackgroundOptionViewModel">
            <Button
                Width="{StaticResource IrisSwatchCellWidth}"
                AutomationProperties.ItemStatus="{x:Bind console:LiveConsolePage.SelectedStatus(IsSelected), Mode=OneWay}"
                AutomationProperties.Name="{x:Bind Name}"
                Click="OnBackgroundChosen"
                Command="{x:Bind Owner.SelectBackgroundCommand}"
                CommandParameter="{x:Bind}"
                Style="{StaticResource IrisPressableButtonStyle}">
                <StackPanel Spacing="6">
                    <Grid
                        Width="{StaticResource IrisSwatchWidth}"
                        Height="{StaticResource IrisSwatchHeight}"
                        HorizontalAlignment="Center">
                        <Border Background="{x:Bind design:IrisTheme.BackgroundBrush(Model)}" CornerRadius="{StaticResource IrisRadiusSwatch}" />
                        <Border
                            BorderBrush="{StaticResource IrisStrokeBrush}"
                            BorderThickness="{StaticResource IrisHairline}"
                            CornerRadius="{StaticResource IrisRadiusSwatch}" />
                        <Border
                            BorderBrush="{StaticResource IrisSelectionRingBrush}"
                            BorderThickness="{StaticResource IrisSelectionRingStroke}"
                            CornerRadius="{StaticResource IrisRadiusSwatch}"
                            Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                    </Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource IrisCaptionTextStyle}"
                        Text="{x:Bind Name}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideColumns">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource IrisConsoleWideBreakpoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SideColumn.Width" Value="{StaticResource IrisColumnWidthWide}" />
                        <Setter Target="LiveColumn.Width" Value="{StaticResource IrisLiveColumnWidth}" />
                        <Setter Target="ServicePanel.(Grid.RowSpan)" Value="2" />
                        <Setter Target="LivePanel.(Grid.Row)" Value="0" />
                        <Setter Target="LivePanel.(Grid.Column)" Value="2" />
                        <Setter Target="LivePanel.(Grid.RowSpan)" Value="2" />
                        <Setter Target="NextPreview.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowColumns" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource IrisTopBarRowHeight}" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ===== Top bar (also the window title bar) =====  -->
        <shell:AppTopBar
            Title="{x:Bind ViewModel.ServiceTitle, Mode=OneWay}"
            BackCommand="{x:Bind ViewModel.RequestExitCommand}"
            Subtitle="{x:Bind ViewModel.ServiceDateText, Mode=OneWay}" />

        <!--
            ===== Toolbar (desktop): the console's main actions with their names, one click away. Groups:
            service · TV screen. The right side is free for what comes next (the iPad keeps these as icons).
        -->
        <Border
            Grid.Row="1"
            Margin="{StaticResource IrisConsoleToolbarMargin}"
            Padding="{StaticResource IrisConsoleToolbarPadding}"
            Style="{StaticResource IrisConsoleSurfaceStyle}">
            <StackPanel
                AutomationProperties.Name="Barra de herramientas"
                Orientation="Horizontal"
                Spacing="{StaticResource IrisSpacingSm}">
                <Button
                    AutomationProperties.Name="Agregar al servicio"
                    Command="{x:Bind ViewModel.PresentAddToServiceCommand}"
                    Style="{StaticResource IrisPillButtonStyle}"
                    ToolTipService.ToolTip="Agregar al servicio (Ctrl+N)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            FontSize="{StaticResource IrisCaptionFontSize}"
                            Glyph="&#xE710;"
                            Style="{StaticResource IrisIconStyle}" />
                        <TextBlock Text="Agregar" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.Name="Biblia"
                    Command="{x:Bind ViewModel.PresentBibleCommand}"
                    Style="{StaticResource IrisPillButtonStyle}"
                    ToolTipService.ToolTip="Biblia (Ctrl+B)"
                    Visibility="{x:Bind ViewModel.ShowsBible, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            FontSize="{StaticResource IrisCaptionFontSize}"
                            Glyph="&#xE82D;"
                            Style="{StaticResource IrisIconStyle}" />
                        <TextBlock Text="Biblia" />
                    </StackPanel>
                </Button>

                <Rectangle Margin="4,6" Style="{StaticResource IrisVerticalSeparatorStyle}" />

                <ToggleButton
                    AutomationProperties.Name="Limpiar pantalla"
                    Command="{x:Bind ViewModel.ToggleClearScreenCommand}"
                    IsChecked="{x:Bind ViewModel.IsScreenCleared, Mode=OneWay}"
                    Style="{StaticResource IrisPillToggleButtonStyle}"
                    ToolTipService.ToolTip="Limpiar pantalla (B)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            FontSize="{StaticResource IrisCaptionFontSize}"
                            Glyph="&#xE75C;"
                            Style="{StaticResource IrisIconStyle}" />
                        <TextBlock Text="Limpiar pantalla" />
                    </StackPanel>
                </ToggleButton>
                <Button
                    x:Name="BackgroundButton"
                    AutomationProperties.Name="Cambiar fondo"
                    Style="{StaticResource IrisPillButtonStyle}"
                    ToolTipService.ToolTip="Cambiar fondo">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            FontSize="{StaticResource IrisCaptionFontSize}"
                            Glyph="&#xE7AA;"
                            Style="{StaticResource IrisIconStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.BackgroundButtonText, Mode=OneWay}" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout
                            x:Name="BackgroundFlyout"
                            FlyoutPresenterStyle="{StaticResource IrisFlyoutPresenterStyle}"
                            Placement="BottomEdgeAlignedLeft">
                            <StackPanel Spacing="{StaticResource IrisSpacingSm}">
                                <controls:IrisSectionHeader Title="Fondos" />
                                <ItemsRepeater
                                    Width="316"
                                    ItemTemplate="{StaticResource BackgroundSwatchTemplate}"
                                    ItemsSource="{x:Bind ViewModel.Backgrounds, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            MaximumRowsOrColumns="3"
                                            MinColumnSpacing="8"
                                            MinItemWidth="{StaticResource IrisSwatchCellWidth}"
                                            MinRowSpacing="12" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Border>

        <!--  ===== Body =====  -->
        <!--
            Narrow window: SERVICIO over EN VIVO | workspace (the iPad layout).
            Wide window (desktop): SERVICIO | workspace | EN VIVO + SIGUIENTE + mini player.
        -->
        <Grid
            Grid.Row="2"
            Padding="{StaticResource IrisConsoleBodyPadding}"
            ColumnSpacing="{StaticResource IrisSpacingMd}"
            RowSpacing="{StaticResource IrisSpacingMd}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideColumn" Width="{StaticResource IrisColumnWidthNarrow}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="LiveColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

                <!--  a) SERVICIO  -->
                <Border
                    x:Name="ServicePanel"
                    Padding="{StaticResource IrisPaddingMd}"
                    Style="{StaticResource IrisConsoleSurfaceStyle}">
                    <Grid RowSpacing="{StaticResource IrisSpacingSm}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <controls:IrisSectionHeader Padding="4,0,0,0" Title="Servicio">
                            <controls:IrisSectionHeader.Accessory>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource IrisNumberTextStyle}"
                                        Text="{x:Bind ViewModel.ItemCountText, Mode=OneWay}" />
                                    <Button
                                        Width="32"
                                        Height="32"
                                        AutomationProperties.Name="Opciones del servicio"
                                        Style="{StaticResource IrisSubtleIconButtonStyle}"
                                        ToolTipService.ToolTip="Opciones del servicio">
                                        <FontIcon Glyph="&#xE712;" Style="{StaticResource IrisIconStyle}" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem
                                                    Command="{x:Bind ViewModel.RequestClearServiceCommand}"
                                                    Foreground="{StaticResource IrisDangerBrush}"
                                                    IsEnabled="{x:Bind ViewModel.HasItems, Mode=OneWay}"
                                                    Text="Vaciar servicio">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Foreground="{StaticResource IrisDangerBrush}" Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </controls:IrisSectionHeader.Accessory>
                        </controls:IrisSectionHeader>

                        <ListView
                            x:Name="ServiceList"
                            Grid.Row="1"
                            AllowDrop="True"
                            AutomationProperties.Name="Servicio"
                            CanDragItems="True"
                            CanReorderItems="True"
                            IsItemClickEnabled="True"
                            ItemClick="OnServiceItemClick"
                            ItemContainerStyle="{StaticResource IrisListRowContainerStyle}"
                            ItemTemplate="{StaticResource ServiceRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.Items}"
                            SelectionMode="None">
                            <ListView.Resources>
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                            </ListView.Resources>
                        </ListView>

                        <StackPanel
                            Grid.Row="1"
                            Padding="{StaticResource IrisPaddingMd}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="{StaticResource IrisSpacingXs}"
                            Visibility="{x:Bind ViewModel.IsServiceEmpty, Mode=OneWay}">
                            <FontIcon
                                FontSize="{StaticResource IrisIconLargeFontSize}"
                                Foreground="{StaticResource IrisTextTertiaryBrush}"
                                Glyph="&#xE8F1;"
                                Style="{StaticResource IrisIconStyle}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource IrisBodyEmphasizedTextStyle}"
                                Text="Servicio vacío" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource IrisCalloutTextStyle}"
                                Text="{x:Bind ViewModel.EmptyServiceHint, Mode=OneWay}"
                                TextAlignment="Center" />
                        </StackPanel>

                        <ProgressRing
                            Grid.Row="1"
                            Width="28"
                            Height="28"
                            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

                        <Button
                            Grid.Row="2"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Agregar"
                            Command="{x:Bind ViewModel.PresentAddToServiceCommand}"
                            Style="{StaticResource IrisPillButtonStyle}"
                            ToolTipService.ToolTip="Agregar al servicio (Ctrl+N)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontSize="{StaticResource IrisCaptionFontSize}"
                                    Glyph="&#xE710;"
                                    Style="{StaticResource IrisIconStyle}" />
                                <TextBlock Text="Agregar" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!--  b) EN VIVO (+ SIGUIENTE on a wide window) + mini player  -->
                <Border
                    x:Name="LivePanel"
                    Grid.Row="1"
                    Padding="{StaticResource IrisPaddingSm}"
                    VerticalAlignment="Top"
                    Style="{StaticResource IrisConsoleSurfaceStyle}">
                    <StackPanel Spacing="{StaticResource IrisSpacingSm}">
                        <Grid AutomationProperties.Name="Pantalla en vivo" CornerRadius="{StaticResource IrisRadiusMd}">
                            <projection:ProjectionCanvas
                                Frame="{x:Bind ViewModel.LiveFrame, Mode=OneWay}"
                                UsesTransitions="True"
                                VideoRole="Preview" />
                            <Border
                                BorderBrush="{StaticResource IrisStrokeStrongBrush}"
                                BorderThickness="{StaticResource IrisHairline}"
                                CornerRadius="{StaticResource IrisRadiusMd}" />
                            <controls:IrisLiveIndicator Margin="{StaticResource IrisPaddingXs}" Text="EN VIVO" />
                        </Grid>

                        <!--  SIGUIENTE: the slide that → sends next (wide window only)  -->
                        <StackPanel
                            x:Name="NextPreview"
                            Spacing="{StaticResource IrisSpacingXs}"
                            Visibility="Collapsed">
                            <controls:IrisSectionHeader Padding="4,0,0,0" Title="Siguiente" />
                            <Grid
                                AutomationProperties.Name="Siguiente diapositiva"
                                CornerRadius="{StaticResource IrisRadiusMd}"
                                Visibility="{x:Bind ViewModel.HasNextSlide, Mode=OneWay}">
                                <projection:ProjectionCanvas DecodePixelWidth="{StaticResource IrisThumbnailDecodeWidth}" Frame="{x:Bind ViewModel.NextFrame, Mode=OneWay}" />
                                <Border
                                    BorderBrush="{StaticResource IrisStrokeBrush}"
                                    BorderThickness="{StaticResource IrisHairline}"
                                    CornerRadius="{StaticResource IrisRadiusMd}" />
                            </Grid>
                            <TextBlock
                                Padding="4,0"
                                Style="{StaticResource IrisCaptionTextStyle}"
                                Text="{x:Bind ViewModel.NextSlideHint, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!--  Mini player: only while music or video is loaded  -->
                        <StackPanel
                            x:Name="NowPlaying"
                            x:Load="{x:Bind ViewModel.HasPlayback, Mode=OneWay}"
                            Padding="4,0,4,4"
                            Spacing="{StaticResource IrisSpacingXs}">
                            <StackPanel.Transitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="24" />
                                </TransitionCollection>
                            </StackPanel.Transitions>
                            <Grid ColumnSpacing="{StaticResource IrisSpacingSm}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Width="{StaticResource IrisRowIconSize}"
                                    Height="{StaticResource IrisRowIconSize}"
                                    Background="{x:Bind design:KindStyle.TintBrush(ViewModel.Playback.Kind), Mode=OneWay}"
                                    CornerRadius="{StaticResource IrisRadiusSm}">
                                    <FontIcon
                                        x:Name="NowPlayingIcon"
                                        Foreground="{x:Bind design:KindStyle.Brush(ViewModel.Playback.Kind), Mode=OneWay}"
                                        Glyph="{x:Bind design:KindStyle.Glyph(ViewModel.Playback.Kind), Mode=OneWay}"
                                        Style="{StaticResource IrisIconStyle}" />
                                    <controls:IrisLiveDot
                                        Margin="0,4,4,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Visibility="{x:Bind ViewModel.Playback.IsPlaying, Mode=OneWay}" />
                                </Grid>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        MaxLines="1"
                                        Style="{StaticResource IrisCalloutEmphasizedTextStyle}"
                                        Text="{x:Bind ViewModel.Playback.Title, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource IrisCaptionTextStyle}" Text="{x:Bind ViewModel.Playback.StatusText, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel>
                                <Slider
                                    AutomationProperties.Name="Posición"
                                    IsThumbToolTipEnabled="False"
                                    Maximum="{x:Bind ViewModel.Playback.Duration, Mode=OneWay}"
                                    Minimum="0"
                                    StepFrequency="0.5"
                                    Value="{x:Bind ViewModel.Playback.Elapsed, Mode=TwoWay}" />
                                <Grid>
                                    <TextBlock Style="{StaticResource IrisNumberTextStyle}" Text="{x:Bind ViewModel.Playback.ElapsedText, Mode=OneWay}" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource IrisNumberTextStyle}"
                                        Text="{x:Bind ViewModel.Playback.RemainingText, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="{StaticResource IrisSpacingSm}">
                                <Button
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Desde el inicio"
                                    Command="{x:Bind ViewModel.RestartPlaybackCommand}"
                                    Style="{StaticResource IrisIconButtonStyle}"
                                    ToolTipService.ToolTip="Desde el inicio">
                                    <FontIcon Glyph="&#xE892;" Style="{StaticResource IrisIconStyle}" />
                                </Button>
                                <Button
                                    Width="{StaticResource IrisControlHeight}"
                                    Height="{StaticResource IrisControlHeight}"
                                    AutomationProperties.Name="{x:Bind ViewModel.Playback.PlayPauseName, Mode=OneWay}"
                                    Background="{StaticResource IrisGlassActiveBrush}"
                                    Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                                    Foreground="{StaticResource IrisTextInverseBrush}"
                                    Style="{StaticResource IrisIconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.Playback.PlayPauseName, Mode=OneWay}">
                                    <Grid>
                                        <FontIcon
                                            Glyph="&#xE769;"
                                            Style="{StaticResource IrisIconStyle}"
                                            Visibility="{x:Bind ViewModel.Playback.IsPlaying, Mode=OneWay}" />
                                        <FontIcon
                                            Glyph="&#xE768;"
                                            Style="{StaticResource IrisIconStyle}"
                                            Visibility="{x:Bind ViewModel.Playback.IsPaused, Mode=OneWay}" />
                                    </Grid>
                                </Button>
                                <Button
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Detener"
                                    Command="{x:Bind ViewModel.StopPlaybackCommand}"
                                    Style="{StaticResource IrisIconButtonStyle}"
                                    ToolTipService.ToolTip="Detener">
                                    <FontIcon Glyph="&#xE71A;" Style="{StaticResource IrisIconStyle}" />
                                </Button>
                                <ToggleButton
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Repetir"
                                    Command="{x:Bind ViewModel.ToggleLoopingCommand}"
                                    IsChecked="{x:Bind ViewModel.Playback.IsLooping, Mode=OneWay}"
                                    Style="{StaticResource IrisIconToggleButtonStyle}"
                                    ToolTipService.ToolTip="Repetir">
                                    <FontIcon Glyph="&#xE8EE;" Style="{StaticResource IrisIconStyle}" />
                                </ToggleButton>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

            <!--  Workspace: block timer (when the service tracks time) + the open item  -->
            <Grid
                Grid.RowSpan="2"
                Grid.Column="1"
                RowSpacing="{StaticResource IrisSpacingMd}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <console:BlockTimerBar ViewModel="{x:Bind ViewModel.BlockTimer, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowsBlockTimer, Mode=OneWay}" />
                <Border
                    Grid.Row="1"
                    Padding="{StaticResource IrisPaddingLg}"
                    Style="{StaticResource IrisConsoleSurfaceStyle}">
                    <Grid RowSpacing="{StaticResource IrisSpacingLg}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Header: chip · title · subtitle | tools  -->
                        <Grid ColumnSpacing="{StaticResource IrisSpacingMd}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="{StaticResource IrisSpacingXs}" Visibility="{x:Bind ViewModel.HasOpenItem, Mode=OneWay}">
                                <controls:IrisChip
                                    Glyph="{x:Bind design:KindStyle.Glyph(ViewModel.OpenKind), Mode=OneWay}"
                                    Text="{x:Bind design:KindStyle.Name(ViewModel.OpenKind), Mode=OneWay}"
                                    Tint="{x:Bind design:KindStyle.Color(ViewModel.OpenKind), Mode=OneWay}" />
                                <TextBlock
                                    AutomationProperties.HeadingLevel="Level1"
                                    MaxLines="1"
                                    Style="{StaticResource IrisTitleTextStyle}"
                                    Text="{x:Bind ViewModel.OpenTitle, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource IrisCalloutTextStyle}" Text="{x:Bind ViewModel.OpenSubtitle, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Orientation="Horizontal"
                                Spacing="{StaticResource IrisSpacingXs}">
                                <Button
                                    AutomationProperties.Name="Versículo anterior"
                                    Command="{x:Bind ViewModel.PreviousCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}"
                                    Style="{StaticResource IrisIconButtonStyle}"
                                    ToolTipService.ToolTip="Versículo anterior (←)"
                                    Visibility="{x:Bind ViewModel.IsShowingScripture, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE76B;" Style="{StaticResource IrisIconStyle}" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Versículo siguiente"
                                    Command="{x:Bind ViewModel.NextCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                                    Style="{StaticResource IrisIconButtonStyle}"
                                    ToolTipService.ToolTip="Versículo siguiente (→)"
                                    Visibility="{x:Bind ViewModel.IsShowingScripture, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE76C;" Style="{StaticResource IrisIconStyle}" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Editar"
                                    Style="{StaticResource IrisPillButtonStyle}"
                                    ToolTipService.ToolTip="Editar"
                                    Visibility="{x:Bind ViewModel.IsEditVisible, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon
                                            FontSize="{StaticResource IrisCaptionFontSize}"
                                            Glyph="&#xE70F;"
                                            Style="{StaticResource IrisIconStyle}" />
                                        <TextBlock Text="Editar" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!--  Content  -->
                        <Grid Grid.Row="1">
                            <!--  Letra / Anuncio / Pasaje: cards  -->
                            <ScrollViewer
                                x:Name="CardsScroller"
                                Padding="0,0,12,0"
                                Visibility="{x:Bind ViewModel.IsShowingCards, Mode=OneWay}">
                                <ItemsRepeater
                                    x:Name="CardsRepeater"
                                    Margin="0,4,0,16"
                                    ItemTemplate="{StaticResource SlideCardTemplate}"
                                    ItemsSource="{x:Bind ViewModel.Cards}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            ItemsStretch="Fill"
                                            MinColumnSpacing="{StaticResource IrisSpacingMd}"
                                            MinItemWidth="{StaticResource IrisSlideCardMinWidth}"
                                            MinRowSpacing="{StaticResource IrisSpacingLg}" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </ScrollViewer>

                            <!--  Música / Video / Imagen: media stage  -->
                            <StackPanel
                                MaxWidth="{StaticResource IrisMediaStageMaxWidth}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Spacing="{StaticResource IrisSpacingLg}"
                                Visibility="{x:Bind ViewModel.IsShowingMedia, Mode=OneWay}">
                                <Button
                                    AutomationProperties.Name="{x:Bind ViewModel.OpenTitle, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.PresentSelectedMediaCommand}"
                                    Style="{StaticResource IrisPressableButtonStyle}"
                                    ToolTipService.ToolTip="Haz clic para presentar">
                                    <Grid CornerRadius="{StaticResource IrisRadiusLg}">
                                        <projection:ProjectionCanvas Frame="{x:Bind ViewModel.MediaFrame, Mode=OneWay}" />
                                        <Border
                                            BorderBrush="{StaticResource IrisStrokeBrush}"
                                            BorderThickness="{StaticResource IrisHairline}"
                                            CornerRadius="{StaticResource IrisRadiusLg}" />
                                        <Border
                                            BorderBrush="{StaticResource IrisAccentGradientBrush}"
                                            BorderThickness="{StaticResource IrisSelectedCardStroke}"
                                            CornerRadius="{StaticResource IrisRadiusLg}"
                                            Visibility="{x:Bind ViewModel.IsSelectedMediaActive, Mode=OneWay}" />
                                        <controls:IrisLiveIndicator
                                            Margin="{StaticResource IrisPaddingSm}"
                                            Text="{x:Bind ViewModel.MediaBadgeText, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.IsSelectedMediaActive, Mode=OneWay}" />
                                    </Grid>
                                </Button>
                                <Button
                                    Width="{StaticResource IrisMediaStageButtonWidth}"
                                    HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.PresentSelectedMediaCommand}"
                                    Content="{x:Bind ViewModel.MediaButtonText, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanPresentSelectedMedia, Mode=OneWay}"
                                    Style="{StaticResource IrisPrimaryButtonStyle}"
                                    Visibility="{x:Bind ViewModel.IsOpenMediaReady, Mode=OneWay}" />
                                <!--  Music and videos added before their file is here (api-contract §11)  -->
                                <Button
                                    Width="{StaticResource IrisMediaStageButtonWidth}"
                                    HorizontalAlignment="Center"
                                    IsEnabled="False"
                                    Style="{StaticResource IrisPrimaryButtonStyle}"
                                    Visibility="{x:Bind ViewModel.IsOpenMediaDownloading, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource IrisSpacingXs}">
                                        <ProgressRing
                                            Width="16"
                                            Height="16"
                                            IsActive="{x:Bind ViewModel.IsOpenMediaDownloading, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ViewModel.MediaDownloadText, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Width="{StaticResource IrisMediaStageButtonWidth}"
                                    HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.RetryMediaDownloadCommand}"
                                    Content="Reintentar descarga"
                                    Style="{StaticResource IrisPrimaryButtonStyle}"
                                    Visibility="{x:Bind ViewModel.IsOpenMediaFailed, Mode=OneWay}" />
                                <TextBlock
                                    MaxWidth="{StaticResource IrisReadableWidth}"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource IrisCalloutTextStyle}"
                                    Text="{x:Bind ViewModel.MediaHint, Mode=OneWay}"
                                    TextAlignment="Center" />
                            </StackPanel>

                            <!--  Nothing selected  -->
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="{StaticResource IrisSpacingXs}"
                                Visibility="{x:Bind ViewModel.IsNothingSelected, Mode=OneWay}">
                                <FontIcon
                                    FontSize="{StaticResource IrisIconLargeFontSize}"
                                    Foreground="{StaticResource IrisTextTertiaryBrush}"
                                    Glyph="&#xE7F4;"
                                    Style="{StaticResource IrisIconStyle}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource IrisBodyEmphasizedTextStyle}"
                                    Text="Selecciona un elemento" />
                            </StackPanel>

                            <!--  Loading / error  -->
                            <ProgressRing
                                Width="36"
                                Height="36"
                                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="{StaticResource IrisSpacingMd}"
                                Visibility="{x:Bind ViewModel.IsFailed, Mode=OneWay}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource IrisBodyEmphasizedTextStyle}"
                                    Text="No pudimos cargar el servicio." />
                                <Button
                                    HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.LoadCommand}"
                                    Content="Reintentar"
                                    Style="{StaticResource IrisPillButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--  Undo toast  -->
        <Border
            x:Name="UndoToast"
            Grid.Row="1"
            x:Load="{x:Bind ViewModel.HasRecentlyRemoved, Mode=OneWay}"
            Height="{StaticResource IrisToastHeight}"
            Margin="0,0,0,32"
            Padding="{StaticResource IrisToastPadding}"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            CornerRadius="{StaticResource IrisRadiusCapsuleToast}"
            Style="{StaticResource IrisGlassCapsuleStyle}">
            <Border.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="32" />
                </TransitionCollection>
            </Border.Transitions>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource IrisSpacingSm}">
                <FontIcon
                    VerticalAlignment="Center"
                    Foreground="{StaticResource IrisTextSecondaryBrush}"
                    Glyph="&#xE74D;"
                    Style="{StaticResource IrisIconStyle}" />
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource IrisCalloutEmphasizedTextStyle}"
                    Text="{x:Bind ViewModel.UndoMessage, Mode=OneWay}" />
                <Button
                    Command="{x:Bind ViewModel.UndoRemovalCommand}"
                    Content="Deshacer"
                    Foreground="{StaticResource IrisEmberBrush}"
                    Style="{StaticResource IrisPillButtonStyle}"
                    ToolTipService.ToolTip="Deshacer (Ctrl+Z)" />
            </StackPanel>
        </Border>

        <!--  ===== Sheets =====  -->
        <controls:IrisModal
            Grid.RowSpan="2"
            CloseCommand="{x:Bind ViewModel.CancelClearServiceCommand}"
            IsOpen="{x:Bind ViewModel.IsConfirmingClear, Mode=OneWay}"
            PanelWidth="{StaticResource IrisConfirmModalWidth}">
            <StackPanel Padding="{StaticResource IrisPaddingXl}" Spacing="{StaticResource IrisSpacingLg}">
                <StackPanel Spacing="{StaticResource IrisSpacingXs}">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource IrisTitleTextStyle}"
                        Text="¿Vaciar el servicio?" />
                    <TextBlock Style="{StaticResource IrisCalloutTextStyle}" Text="Esta acción no se puede deshacer." />
                </StackPanel>
                <StackPanel Spacing="{StaticResource IrisSpacingSm}">
                    <Button
                        Command="{x:Bind ViewModel.ClearServiceCommand}"
                        Content="{x:Bind ViewModel.ClearServiceButtonText, Mode=OneWay}"
                        Style="{StaticResource IrisDangerButtonStyle}" />
                    <Button
                        Command="{x:Bind ViewModel.CancelClearServiceCommand}"
                        Content="Cancelar"
                        Style="{StaticResource IrisGlassButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </controls:IrisModal>

        <controls:IrisModal
            Grid.RowSpan="2"
            CloseCommand="{x:Bind ViewModel.CloseBibleCommand}"
            IsOpen="{x:Bind ViewModel.IsBibleOpen, Mode=OneWay}"
            PanelHeight="640"
            PanelWidth="{StaticResource IrisFormModalWidth}">
            <bible:BiblePickerView CloseCommand="{x:Bind ViewModel.CloseBibleCommand}" ViewModel="{x:Bind ViewModel.BiblePicker, Mode=OneWay}" />
        </controls:IrisModal>

        <controls:IrisModal
            Grid.RowSpan="2"
            CloseCommand="{x:Bind ViewModel.CloseAddToServiceCommand}"
            IsOpen="{x:Bind ViewModel.IsAddOpen, Mode=OneWay}"
            PanelHeight="720"
            PanelWidth="{StaticResource IrisPageModalWidth}">
            <add:AddToServiceView CloseCommand="{x:Bind ViewModel.CloseAddToServiceCommand}" ViewModel="{x:Bind ViewModel.AddSheet, Mode=OneWay}" />
        </controls:IrisModal>

        <!--  Block-timer sheets  -->
        <console:BlockTimerSheets Grid.RowSpan="2" ViewModel="{x:Bind ViewModel.BlockTimer, Mode=OneWay}" />
    </Grid>
</Page>
