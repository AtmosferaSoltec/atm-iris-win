<?xml version="1.0" encoding="utf-8"?>
<!--  "Agregar al servicio" sheet (IRIS_SPEC §6.4).  -->
<UserControl
    x:Class="Iris.Features.AddToService.AddToServiceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:add="using:Iris.Features.AddToService"
    xmlns:controls="using:Iris.DesignSystem.Controls"
    xmlns:design="using:Iris.DesignSystem"
    xmlns:projection="using:Iris.Shared.Projection">

    <UserControl.Resources>
        <!--  Letras / Música rows  -->
        <DataTemplate x:Key="RowTemplate" x:DataType="add:LibraryEntryViewModel">
            <Button
                AutomationProperties.Name="{x:Bind Title}"
                Command="{x:Bind Owner.ToggleCommand}"
                CommandParameter="{x:Bind}"
                Style="{StaticResource IrisPressableButtonStyle}">
                <Grid
                    Padding="{StaticResource IrisPaddingSm}"
                    Background="{StaticResource IrisSurfaceBrush}"
                    BorderBrush="{StaticResource IrisStrokeBrush}"
                    BorderThickness="{StaticResource IrisHairline}"
                    ColumnSpacing="{StaticResource IrisSpacingSm}"
                    CornerRadius="{StaticResource IrisRadiusMd}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.ColumnSpan="4"
                        Margin="-12"
                        BorderBrush="{StaticResource IrisAccentGradientBrush}"
                        BorderThickness="{StaticResource IrisFocusStroke}"
                        CornerRadius="{StaticResource IrisRadiusMd}"
                        Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                    <Grid
                        Width="{StaticResource IrisRowIconSize}"
                        Height="{StaticResource IrisRowIconSize}"
                        VerticalAlignment="Center"
                        Background="{x:Bind design:KindStyle.TintBrush(Kind)}"
                        CornerRadius="{StaticResource IrisRadiusSm}">
                        <FontIcon
                            Foreground="{x:Bind design:KindStyle.Brush(Kind)}"
                            Glyph="{x:Bind design:KindStyle.Glyph(Kind)}"
                            Style="{StaticResource IrisIconStyle}" />
                    </Grid>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock Style="{StaticResource IrisCalloutEmphasizedTextStyle}" Text="{x:Bind Title}" />
                        <TextBlock Style="{StaticResource IrisCaptionTextStyle}" Text="{x:Bind Subtitle}" />
                        <TextBlock
                            Style="{StaticResource IrisCaptionTextStyle}"
                            Text="{x:Bind StatusText, Mode=OneWay}"
                            Visibility="{x:Bind IsUnavailable, Mode=OneWay}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontFamily="{StaticResource IrisSerifTextFontFamily}"
                            FontSize="{StaticResource IrisCalloutFontSize}"
                            FontStyle="Italic"
                            Foreground="{StaticResource IrisTextSecondaryBrush}"
                            MaxLines="1"
                            Text="{x:Bind FirstLine}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind HasFirstLine}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource IrisNumberTextStyle}"
                        Text="{x:Bind Duration}"
                        Visibility="{x:Bind HasDuration}" />
                    <controls:IrisCheckmark
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        IsChecked="{x:Bind IsSelected, Mode=OneWay}" />
                </Grid>
            </Button>
        </DataTemplate>

        <!--  Imágenes / Videos tiles  -->
        <DataTemplate x:Key="TileTemplate" x:DataType="add:LibraryEntryViewModel">
            <Button
                AutomationProperties.Name="{x:Bind Title}"
                Command="{x:Bind Owner.ToggleCommand}"
                CommandParameter="{x:Bind}"
                Style="{StaticResource IrisPressableButtonStyle}">
                <StackPanel Spacing="{StaticResource IrisSpacingXs}">
                    <Grid CornerRadius="{StaticResource IrisRadiusMd}">
                        <projection:ProjectionCanvas DecodePixelWidth="{StaticResource IrisThumbnailDecodeWidth}" Frame="{x:Bind ThumbnailFrame, Mode=OneWay}" />
                        <!--  Not on this PC yet: progress instead of the picture; it can still be chosen (adding it downloads it)  -->
                        <Grid Background="{StaticResource IrisScrimBrush}" Visibility="{x:Bind IsUnavailable, Mode=OneWay}">
                            <StackPanel
                                Margin="{StaticResource IrisPaddingXs}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="{StaticResource IrisSpacingXs}">
                                <ProgressBar
                                    Width="{StaticResource IrisDownloadBarWidth}"
                                    Maximum="100"
                                    Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                    Visibility="{x:Bind IsDownloading, Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource IrisCaptionTextStyle}"
                                    Text="{x:Bind StatusText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                        <Grid
                            Width="44"
                            Height="44"
                            Visibility="{x:Bind IsVideo}">
                            <Ellipse Fill="{StaticResource IrisScrimBrush}" Stroke="{StaticResource IrisStrokeStrongBrush}" />
                            <FontIcon Glyph="&#xE768;" Style="{StaticResource IrisIconStyle}" />
                        </Grid>
                        <Border
                            Margin="{StaticResource IrisPaddingXs}"
                            Padding="8,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="{StaticResource IrisScrimBrush}"
                            CornerRadius="{StaticResource IrisRadiusCapsuleTag}"
                            Visibility="{x:Bind HasDuration}">
                            <TextBlock
                                Foreground="{StaticResource IrisTextPrimaryBrush}"
                                Style="{StaticResource IrisNumberTextStyle}"
                                Text="{x:Bind Duration}" />
                        </Border>
                        <controls:IrisCheckmark
                            Margin="{StaticResource IrisPaddingXs}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            IsChecked="{x:Bind IsSelected, Mode=OneWay}" />
                        <Border
                            BorderBrush="{StaticResource IrisStrokeBrush}"
                            BorderThickness="{StaticResource IrisHairline}"
                            CornerRadius="{StaticResource IrisRadiusMd}" />
                        <Border
                            BorderBrush="{StaticResource IrisAccentGradientBrush}"
                            BorderThickness="{StaticResource IrisSelectedCardStroke}"
                            CornerRadius="{StaticResource IrisRadiusMd}"
                            Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                    </Grid>
                    <StackPanel Spacing="2">
                        <TextBlock
                            MaxLines="1"
                            Style="{StaticResource IrisCalloutEmphasizedTextStyle}"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource IrisCaptionTextStyle}" Text="{x:Bind Subtitle}" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Padding="{StaticResource IrisPaddingLg}" RowSpacing="{StaticResource IrisSpacingMd}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="{StaticResource IrisSpacingSm}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource IrisTitleTextStyle}"
                    Text="Agregar al servicio" />
                <TextBlock Style="{StaticResource IrisCalloutTextStyle}" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay, FallbackValue=''}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                VerticalAlignment="Top"
                AutomationProperties.Name="Cerrar"
                Command="{x:Bind CloseCommand, Mode=OneWay}"
                Style="{StaticResource IrisIconButtonStyle}"
                ToolTipService.ToolTip="Cerrar">
                <FontIcon Glyph="&#xE711;" Style="{StaticResource IrisIconStyle}" />
            </Button>
        </Grid>

        <controls:IrisSegmentedControl
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.IncludesMultimedia, Mode=OneWay, FallbackValue=Collapsed}"
            Items="{x:Bind ViewModel.Tabs, Mode=OneWay}"
            SelectedIndex="{x:Bind ViewModel.TabIndex, Mode=TwoWay}" />

        <StackPanel Grid.Row="2" Spacing="{StaticResource IrisSpacingSm}">
            <controls:IrisTextField
                Glyph="&#xE721;"
                Placeholder="Título, autor o descripción"
                Text="{x:Bind ViewModel.Query, Mode=TwoWay}" />
            <!--  Música: tracks come from the web and download when added (api-contract §11)  -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="{StaticResource IrisSpacingSm}"
                Visibility="{x:Bind ViewModel.ShowsMusicHint, Mode=OneWay, FallbackValue=Collapsed}">
                <FontIcon
                    Foreground="{StaticResource IrisSuccessBrush}"
                    Glyph="&#xE753;"
                    Style="{StaticResource IrisIconStyle}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource IrisCalloutTextStyle}"
                    Text="Se suben desde la web, en Música. Al agregarlas al servicio se descargan y quedan en esta computadora."
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="3">
            <ScrollViewer Padding="0,0,12,0" Visibility="{x:Bind ViewModel.IsRowTab, Mode=OneWay, FallbackValue=Collapsed}">
                <ItemsRepeater ItemTemplate="{StaticResource RowTemplate}" ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
            <ScrollViewer Padding="0,0,12,0" Visibility="{x:Bind ViewModel.IsTileTab, Mode=OneWay, FallbackValue=Collapsed}">
                <ItemsRepeater ItemTemplate="{StaticResource TileTemplate}" ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="16"
                            MinItemWidth="{StaticResource IrisLibraryTileMinWidth}"
                            MinRowSpacing="16" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="{StaticResource IrisSpacingXs}"
                Visibility="{x:Bind ViewModel.HasNoResults, Mode=OneWay, FallbackValue=Collapsed}">
                <FontIcon
                    FontSize="{StaticResource IrisIconLargeFontSize}"
                    Foreground="{StaticResource IrisTextTertiaryBrush}"
                    Glyph="&#xE721;"
                    Style="{StaticResource IrisIconStyle}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource IrisBodyEmphasizedTextStyle}"
                    Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource IrisCalloutTextStyle}"
                    Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" />
            </StackPanel>

            <ProgressRing
                Width="32"
                Height="32"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay, FallbackValue=False}" />
        </Grid>

        <Grid
            Grid.Row="4"
            Padding="0,8,0,0"
            BorderBrush="{StaticResource IrisStrokeBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="{StaticResource IrisSpacingMd}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource IrisLabelTextStyle}"
                Text="{x:Bind ViewModel.SelectedCountText, Mode=OneWay}" />
            <Button
                Grid.Column="1"
                Width="{StaticResource IrisAddButtonWidth}"
                Command="{x:Bind ViewModel.ConfirmCommand, Mode=OneWay}"
                Content="Agregar al servicio"
                IsEnabled="{x:Bind ViewModel.CanConfirm, Mode=OneWay, FallbackValue=False}"
                Style="{StaticResource IrisPrimaryButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>
