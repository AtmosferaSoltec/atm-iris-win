<?xml version="1.0" encoding="utf-8"?>
<!--  Bible sheet (IRIS_SPEC §6.3): book (search + testament) → chapter → verse.  -->
<UserControl
    x:Class="Iris.Features.Bible.BiblePickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bible="using:Iris.Features.Bible"
    xmlns:controls="using:Iris.DesignSystem.Controls">

    <UserControl.Resources>
        <DataTemplate x:Key="BookCellTemplate" x:DataType="bible:PickerCell">
            <Button
                MinHeight="64"
                HorizontalContentAlignment="Left"
                AutomationProperties.Name="{x:Bind Title}"
                Command="{x:Bind Command}"
                CommandParameter="{x:Bind Value}"
                Style="{StaticResource IrisCellButtonStyle}">
                <StackPanel Spacing="2">
                    <TextBlock
                        MaxLines="1"
                        Style="{StaticResource IrisCalloutEmphasizedTextStyle}"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource IrisCaptionTextStyle}" Text="{x:Bind Detail}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="NumberCellTemplate" x:DataType="bible:PickerCell">
            <Button
                Height="{StaticResource IrisNumberCellHeight}"
                Padding="0"
                AutomationProperties.Name="{x:Bind Title}"
                Command="{x:Bind Command}"
                CommandParameter="{x:Bind Value}"
                FontFamily="{StaticResource IrisSansDisplayFontFamily}"
                FontSize="{StaticResource IrisNumberCellFontSize}"
                FontWeight="SemiBold"
                Style="{StaticResource IrisCellButtonStyle}">
                <TextBlock Text="{x:Bind Title}" />
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Padding="{StaticResource IrisPaddingLg}" RowSpacing="{StaticResource IrisSpacingMd}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: back · title/subtitle · close  -->
        <Grid ColumnSpacing="{StaticResource IrisSpacingSm}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.BackCommand, Mode=OneWay}"
                Style="{StaticResource IrisPillButtonStyle}"
                Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay, FallbackValue=Collapsed}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        FontSize="{StaticResource IrisCaptionFontSize}"
                        Glyph="&#xE76B;"
                        Style="{StaticResource IrisIconStyle}" />
                    <TextBlock Text="Atrás" />
                </StackPanel>
            </Button>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource IrisTitleTextStyle}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                <TextBlock Style="{StaticResource IrisCaptionTextStyle}" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
            </StackPanel>
            <Button
                Grid.Column="2"
                VerticalAlignment="Top"
                AutomationProperties.Name="Cerrar"
                Command="{x:Bind CloseCommand, Mode=OneWay}"
                Style="{StaticResource IrisIconButtonStyle}"
                ToolTipService.ToolTip="Cerrar">
                <FontIcon Glyph="&#xE711;" Style="{StaticResource IrisIconStyle}" />
            </Button>
        </Grid>

        <!--  Step 1: book  -->
        <Grid
            Grid.Row="1"
            RowSpacing="{StaticResource IrisSpacingMd}"
            Visibility="{x:Bind ViewModel.IsBookStep, Mode=OneWay, FallbackValue=Collapsed}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:IrisTextField
                Glyph="&#xE721;"
                Label="Buscar libro"
                Placeholder="Ej. Juan, Salmos, Romanos"
                Text="{x:Bind ViewModel.Query, Mode=TwoWay}" />
            <controls:IrisSegmentedControl
                Grid.Row="1"
                Items="{x:Bind ViewModel.Testaments, Mode=OneWay}"
                SelectedIndex="{x:Bind ViewModel.TestamentIndex, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsNotSearching, Mode=OneWay, FallbackValue=Visible}" />
            <ScrollViewer Grid.Row="2" Padding="0,0,12,0">
                <ItemsRepeater ItemTemplate="{StaticResource BookCellTemplate}" ItemsSource="{x:Bind ViewModel.Books, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="8"
                            MinItemWidth="{StaticResource IrisBookCellMinWidth}"
                            MinRowSpacing="8" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
            <TextBlock
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource IrisCalloutTextStyle}"
                Text="No encontramos ese libro."
                Visibility="{x:Bind ViewModel.HasNoBooks, Mode=OneWay, FallbackValue=Collapsed}" />
        </Grid>

        <!--  Steps 2–3: chapter / verse numbers  -->
        <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.IsNumberStep, Mode=OneWay, FallbackValue=Collapsed}">
            <ScrollViewer Padding="0,0,12,0">
                <ItemsRepeater ItemTemplate="{StaticResource NumberCellTemplate}" ItemsSource="{x:Bind ViewModel.Numbers, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="8"
                            MinItemWidth="{StaticResource IrisNumberCellMinWidth}"
                            MinRowSpacing="8" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
            <ProgressRing
                Width="32"
                Height="32"
                IsActive="{x:Bind ViewModel.IsLoadingNumbers, Mode=OneWay, FallbackValue=False}" />
        </Grid>
    </Grid>
</UserControl>
