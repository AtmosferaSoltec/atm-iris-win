<?xml version="1.0" encoding="utf-8"?>
<!--  Tiempos (IRIS_SPEC §6.10): Registros (list by month + detail) | Resúmenes (filters, KPIs, by person, by block).  -->
<Page
    x:Class="Iris.Features.Times.TimesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Iris.DesignSystem.Controls"
    xmlns:design="using:Iris.DesignSystem"
    xmlns:shell="using:Iris.Shell"
    xmlns:times="using:Iris.Features.Times"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="FilterOptionTemplate" x:DataType="times:FilterOption">
            <Button
                Padding="12,8"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Click="OnFilterChosen"
                Command="{x:Bind Owner.ChooseFilterCommand}"
                CommandParameter="{x:Bind}"
                Style="{StaticResource IrisPressableButtonStyle}">
                <Grid ColumnSpacing="{StaticResource IrisSpacingSm}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource IrisCalloutEmphasizedTextStyle}" Text="{x:Bind Label}" />
                    <FontIcon
                        Grid.Column="1"
                        FontSize="{StaticResource IrisCaptionFontSize}"
                        Foreground="{StaticResource IrisCoralBrush}"
                        Glyph="&#xE73E;"
                        Style="{StaticResource IrisIconStyle}"
                        Visibility="{x:Bind IsSelected}" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="RecordRowTemplate" x:DataType="times:RecordRowViewModel">
            <Button
                AutomationProperties.ItemStatus="{x:Bind times:TimesPage.SelectedStatus(IsSelected), Mode=OneWay}"
                AutomationProperties.Name="{x:Bind AccessibleName}"
                Command="{x:Bind Owner.SelectRecordCommand}"
                CommandParameter="{x:Bind}"
                Style="{StaticResource IrisPressableButtonStyle}">
                <Grid CornerRadius="{StaticResource IrisRadiusMd}">
                    <Border
                        Background="{StaticResource IrisSurfaceRaisedBrush}"
                        CornerRadius="{StaticResource IrisRadiusMd}"
                        Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                    <Rectangle
                        Width="{StaticResource IrisSelectionBarWidth}"
                        Margin="0,10"
                        HorizontalAlignment="Left"
                        Fill="{StaticResource IrisAccentGradientBrush}"
                        RadiusX="1.5"
                        RadiusY="1.5"
                        Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                    <Grid Padding="{StaticResource IrisRowPadding}" ColumnSpacing="{StaticResource IrisSpacingSm}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Fill="{x:Bind design:IrisTheme.HexBrush(Color)}" Style="{StaticResource IrisStatusDotStyle}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                MaxLines="1"
                                Style="{StaticResource IrisCalloutEmphasizedTextStyle}"
                                Text="{x:Bind TypeName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource IrisCaptionTextStyle}" Text="{x:Bind DateText}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Spacing="4">
                            <TextBlock
                                HorizontalAlignment="Right"
                                Foreground="{StaticResource IrisTextPrimaryBrush}"
                                Style="{StaticResource IrisNumberTextStyle}"
                                Text="{x:Bind DurationText}" />
                            <controls:IrisChip
                                HorizontalAlignment="Right"
                                Text="{x:Bind DeltaText}"
                                Tint="{x:Bind design:Bind.OverColor(IsOver)}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="RecordGroupTemplate" x:DataType="times:RecordGroup">
            <StackPanel Padding="0,0,0,12" Spacing="{StaticResource IrisSpacingXs}">
                <controls:IrisSectionHeader Padding="4,8,0,0" Title="{x:Bind Header}" />
                <ItemsRepeater ItemTemplate="{StaticResource RecordRowTemplate}" ItemsSource="{x:Bind Rows}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="2" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BlockDetailTemplate" x:DataType="times:BlockDetailRow">
            <Grid Padding="0,12" ColumnSpacing="{StaticResource IrisSpacingMd}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Foreground="{x:Bind times:TimesPage.BlockNameBrush(IsSkipped)}"
                        Style="{StaticResource IrisCalloutEmphasizedTextStyle}"
                        Text="{x:Bind Name}" />
                    <TextBlock Style="{StaticResource IrisCaptionTextStyle}" Text="{x:Bind Leader}" />
                </StackPanel>
                <controls:IrisTimeBar
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Actual="{x:Bind Block.ActualSeconds}"
                    MaxValue="{x:Bind Scale}"
                    Planned="{x:Bind Block.PlannedSeconds}"
                    Visibility="{x:Bind IsCounted}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource IrisCaptionTextStyle}"
                    Text="Omitido"
                    Visibility="{x:Bind IsSkipped}" />
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{StaticResource IrisSpacingXs}"
                    Visibility="{x:Bind IsCounted}">
                    <controls:IrisChip
                        VerticalAlignment="Center"
                        Text="Ajustado"
                        Tint="{x:Bind design:Bind.Color('IrisIndigoColor')}"
                        Visibility="{x:Bind IsAdjusted}" />
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            HorizontalAlignment="Right"
                            Foreground="{StaticResource IrisTextPrimaryBrush}"
                            Style="{StaticResource IrisNumberTextStyle}"
                            Text="{x:Bind ActualText}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            Foreground="{x:Bind design:Bind.OverBrush(IsOver)}"
                            Style="{StaticResource IrisNumberTextStyle}"
                            Text="{x:Bind DeltaText}" />
                    </StackPanel>
                </StackPanel>
                <Button
                    Grid.Column="3"
                    Width="32"
                    Height="32"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Opciones del bloque"
                    Style="{StaticResource IrisSubtleIconButtonStyle}"
                    ToolTipService.ToolTip="Opciones del bloque"
                    Visibility="{x:Bind IsCounted}">
                    <FontIcon Glyph="&#xE712;" Style="{StaticResource IrisIconStyle}" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem
                                Command="{x:Bind Owner.BeginAdjustmentCommand}"
                                CommandParameter="{x:Bind}"
                                Text="Ajustar duración…">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE916;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Command="{x:Bind Owner.BeginLeaderChangeCommand}"
                                CommandParameter="{x:Bind}"
                                Text="Cambiar responsable">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE77B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="KpiTemplate" x:DataType="times:KpiCard">
            <Border Padding="{StaticResource IrisPaddingLg}" Style="{StaticResource IrisConsoleSurfaceStyle}">
                <StackPanel Spacing="{StaticResource IrisSpacingXs}">
                    <TextBlock Style="{StaticResource IrisCaptionTextStyle}" Text="{x:Bind Title}" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource IrisSpacingXs}">
                        <TextBlock Style="{StaticResource IrisMetricTextStyle}" Text="{x:Bind Value}" />
                        <TextBlock
                            VerticalAlignment="Bottom"
                            Style="{StaticResource IrisCaptionTextStyle}"
                            Text="{x:Bind Detail}"
                            Visibility="{x:Bind HasDetail}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PersonStatTemplate" x:DataType="times:PersonStatRow">
            <Button
                AutomationProperties.HelpText="Ver sus bloques"
                AutomationProperties.Name="{x:Bind Name}"
                Command="{x:Bind Owner.ShowPersonDetailCommand}"
                CommandParameter="{x:Bind}"
                Style="{StaticResource IrisPressableButtonStyle}"
                ToolTipService.ToolTip="Ver sus bloques">
                <Grid
                    Padding="{StaticResource IrisRowPadding}"
                    Background="{StaticResource IrisSurfaceBrush}"
                    ColumnSpacing="{StaticResource IrisSpacingSm}"
                    CornerRadius="{StaticResource IrisRadiusMd}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource IrisTableNumberColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource IrisTableNumberColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource IrisTableNumberColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource IrisTableNumberColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource IrisTableNumberColumnWidth}" />
                    </Grid.ColumnDefinitions>
                    <controls:IrisAvatar
                        ColorIndex="{x:Bind ColorIndex}"
                        Initials="{x:Bind Initials}"
                        Size="{StaticResource IrisRowIconSize}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource IrisCalloutEmphasizedTextStyle}"
                        Text="{x:Bind Name}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource IrisTextPrimaryBrush}"
                        Style="{StaticResource IrisNumberTextStyle}"
                        Text="{x:Bind Participations}" />
                    <TextBlock
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource IrisTextPrimaryBrush}"
                        Style="{StaticResource IrisNumberTextStyle}"
                        Text="{x:Bind TimesOver}" />
                    <TextBlock
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource IrisTextPrimaryBrush}"
                        Style="{StaticResource IrisNumberTextStyle}"
                        Text="{x:Bind AverageOver}" />
                    <TextBlock
                        Grid.Column="5"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource IrisTextPrimaryBrush}"
                        Style="{StaticResource IrisNumberTextStyle}"
                        Text="{x:Bind MaxOver}" />
                    <TextBlock
                        Grid.Column="6"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource IrisTextPrimaryBrush}"
                        Style="{StaticResource IrisNumberTextStyle}"
                        Text="{x:Bind TotalOver}" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="BlockStatTemplate" x:DataType="times:BlockStatRow">
            <Grid
                Padding="{StaticResource IrisRowPadding}"
                Background="{StaticResource IrisSurfaceBrush}"
                ColumnSpacing="{StaticResource IrisSpacingMd}"
                CornerRadius="{StaticResource IrisRadiusMd}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="{StaticResource IrisTableNumberColumnWidth}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Fill="{x:Bind design:Spectrum.Brush(ColorIndex)}" Style="{StaticResource IrisStatusDotStyle}" />
                        <TextBlock Style="{StaticResource IrisCalloutEmphasizedTextStyle}" Text="{x:Bind Name}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource IrisCaptionTextStyle}" Text="{x:Bind TimesOverText}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock Style="{StaticResource IrisCaptionTextStyle}" Text="Exceso promedio" />
                    <TextBlock
                        Foreground="{StaticResource IrisTextPrimaryBrush}"
                        Style="{StaticResource IrisNumberTextStyle}"
                        Text="{x:Bind AverageOver}" />
                </StackPanel>
                <controls:IrisTimeBar
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Actual="{x:Bind AverageActual}"
                    MaxValue="{x:Bind Scale}"
                    Planned="{x:Bind AveragePlanned}" />
                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource IrisTextPrimaryBrush}"
                    Style="{StaticResource IrisNumberTextStyle}"
                    Text="{x:Bind ActualVsPlanned}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PersonBlockTemplate" x:DataType="times:PersonBlockRow">
            <Grid
                Padding="{StaticResource IrisRowPadding}"
                Background="{StaticResource IrisSurfaceBrush}"
                ColumnSpacing="{StaticResource IrisSpacingMd}"
                CornerRadius="{StaticResource IrisRadiusMd}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource IrisTableNumberColumnWidth}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{StaticResource IrisTableNumberColumnWidth}" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IrisCaptionTextStyle}" Text="{x:Bind Date}" />
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource IrisCalloutTextStyle}"
                    Text="{x:Bind Service}" />
                <TextBlock
                    Grid.Column="2"
                    Style="{StaticResource IrisCalloutEmphasizedTextStyle}"
                    Text="{x:Bind Block}" />
                <TextBlock
                    Grid.Column="3"
                    Foreground="{StaticResource IrisTextPrimaryBrush}"
                    Style="{StaticResource IrisNumberTextStyle}"
                    Text="{x:Bind ActualVsPlanned}" />
                <TextBlock
                    Grid.Column="4"
                    HorizontalAlignment="Right"
                    Foreground="{x:Bind design:Bind.OverBrush(IsOver)}"
                    Style="{StaticResource IrisNumberTextStyle}"
                    Text="{x:Bind Overtime}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LeaderChoiceTemplate" x:DataType="times:LeaderChoice">
            <Button
                Padding="{StaticResource IrisRowPadding}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Command="{x:Bind Owner.ChangeLeaderCommand}"
                CommandParameter="{x:Bind}"
                Style="{StaticResource IrisPressableButtonStyle}">
                <Grid>
                    <TextBlock Style="{StaticResource IrisCalloutEmphasizedTextStyle}" Text="{x:Bind Name}" />
                    <controls:IrisCheckmark HorizontalAlignment="Right" IsChecked="{x:Bind IsSelected}" />
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource IrisTopBarRowHeight}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <shell:AppTopBar Title="Tiempos" BackCommand="{x:Bind ViewModel.GoHomeCommand}" />

        <Grid
            Grid.Row="1"
            MaxWidth="{StaticResource IrisContentWidth}"
            Padding="{StaticResource IrisPagePadding}"
            RowSpacing="{StaticResource IrisSpacingLg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="{StaticResource IrisSpacingLg}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource IrisHeadlineTextStyle}"
                    Text="Tiempos" />
                <controls:IrisSegmentedControl
                    Grid.Column="1"
                    Width="300"
                    VerticalAlignment="Center"
                    Items="{x:Bind ViewModel.Tabs}"
                    SelectedIndex="{x:Bind ViewModel.TabIndex, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.HasRecords, Mode=OneWay}" />
            </Grid>

            <!--  Empty  -->
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="{StaticResource IrisSpacingXs}"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon
                    FontSize="{StaticResource IrisIconLargeFontSize}"
                    Foreground="{StaticResource IrisTextTertiaryBrush}"
                    Glyph="&#xE916;"
                    Style="{StaticResource IrisIconStyle}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource IrisBodyEmphasizedTextStyle}"
                    Text="Aún no hay tiempos" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource IrisCalloutTextStyle}"
                    Text="Se guardan al terminar un servicio con bloques." />
            </StackPanel>
            <ProgressRing
                Grid.Row="1"
                Width="32"
                Height="32"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <!--  ===== Registros =====  -->
            <Grid
                Grid.Row="1"
                ColumnSpacing="{StaticResource IrisSpacingMd}"
                Visibility="{x:Bind ViewModel.IsRecordsTab, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource IrisRecordListColumnWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="{StaticResource IrisPaddingMd}" Style="{StaticResource IrisConsoleSurfaceStyle}">
                    <Grid RowSpacing="{StaticResource IrisSpacingSm}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button HorizontalAlignment="Left" Style="{StaticResource IrisPillButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.RecordTypeFilterText, Mode=OneWay}" />
                                <FontIcon
                                    FontSize="10"
                                    Glyph="&#xE70D;"
                                    Style="{StaticResource IrisIconStyle}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="RecordTypeFlyout" FlyoutPresenterStyle="{StaticResource IrisFlyoutPresenterStyle}">
                                    <ItemsRepeater
                                        MinWidth="220"
                                        ItemTemplate="{StaticResource FilterOptionTemplate}"
                                        ItemsSource="{x:Bind ViewModel.RecordTypeOptions, Mode=OneWay}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <ScrollViewer Grid.Row="1" Padding="0,0,8,0">
                            <ItemsRepeater ItemTemplate="{StaticResource RecordGroupTemplate}" ItemsSource="{x:Bind ViewModel.Groups}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="{StaticResource IrisPaddingLg}"
                    Style="{StaticResource IrisConsoleSurfaceStyle}">
                    <Grid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource IrisBodyEmphasizedTextStyle}"
                            Text="Selecciona un registro"
                            Visibility="{x:Bind ViewModel.HasNoSelection, Mode=OneWay}" />
                        <ScrollViewer Padding="0,0,8,0" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                            <StackPanel Spacing="{StaticResource IrisSpacingLg}">
                                <StackPanel Spacing="{StaticResource IrisSpacingXxs}">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource IrisTitleTextStyle}"
                                        Text="{x:Bind ViewModel.DetailTitle, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource IrisCalloutTextStyle}" Text="{x:Bind ViewModel.DetailDate, Mode=OneWay}" />
                                </StackPanel>

                                <Grid ColumnSpacing="{StaticResource IrisSpacingMd}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource IrisCaptionTextStyle}" Text="Duración" />
                                        <TextBlock Style="{StaticResource IrisMetricTextStyle}" Text="{x:Bind ViewModel.DetailDuration, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Style="{StaticResource IrisCaptionTextStyle}" Text="Previsto" />
                                        <TextBlock Style="{StaticResource IrisMetricTextStyle}" Text="{x:Bind ViewModel.DetailPlanned, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Style="{StaticResource IrisCaptionTextStyle}" Text="Exceso" />
                                        <TextBlock
                                            Foreground="{x:Bind design:Bind.OverBrush(ViewModel.DetailIsOver), Mode=OneWay}"
                                            Style="{StaticResource IrisMetricTextStyle}"
                                            Text="{x:Bind ViewModel.DetailOvertime, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel>
                                    <controls:IrisSectionHeader Title="Bloques" />
                                    <ItemsRepeater ItemTemplate="{StaticResource BlockDetailTemplate}" ItemsSource="{x:Bind ViewModel.DetailBlocks, Mode=OneWay}" />
                                </StackPanel>

                                <Button
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.RequestDeleteSelectedCommand}"
                                    Content="Eliminar registro"
                                    Foreground="{StaticResource IrisDangerBrush}"
                                    Style="{StaticResource IrisLinkButtonStyle}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!--  ===== Resúmenes =====  -->
            <Grid
                Grid.Row="1"
                RowSpacing="{StaticResource IrisSpacingLg}"
                Visibility="{x:Bind ViewModel.IsSummaryTab, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="{StaticResource IrisSpacingXs}">
                    <Button Style="{StaticResource IrisPillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontSize="{StaticResource IrisCaptionFontSize}"
                                Glyph="&#xE787;"
                                Style="{StaticResource IrisIconStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.PeriodText, Mode=OneWay}" />
                            <FontIcon
                                FontSize="10"
                                Glyph="&#xE70D;"
                                Style="{StaticResource IrisIconStyle}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="PeriodFlyout" FlyoutPresenterStyle="{StaticResource IrisFlyoutPresenterStyle}">
                                <ItemsRepeater
                                    MinWidth="220"
                                    ItemTemplate="{StaticResource FilterOptionTemplate}"
                                    ItemsSource="{x:Bind ViewModel.PeriodOptions, Mode=OneWay}" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Style="{StaticResource IrisPillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.ServiceFilterText, Mode=OneWay}" />
                            <FontIcon
                                FontSize="10"
                                Glyph="&#xE70D;"
                                Style="{StaticResource IrisIconStyle}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="ServiceFlyout" FlyoutPresenterStyle="{StaticResource IrisFlyoutPresenterStyle}">
                                <ItemsRepeater
                                    MinWidth="220"
                                    ItemTemplate="{StaticResource FilterOptionTemplate}"
                                    ItemsSource="{x:Bind ViewModel.ServiceOptions, Mode=OneWay}" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Style="{StaticResource IrisPillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.BlockFilterText, Mode=OneWay}" />
                            <FontIcon
                                FontSize="10"
                                Glyph="&#xE70D;"
                                Style="{StaticResource IrisIconStyle}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="BlockFlyout" FlyoutPresenterStyle="{StaticResource IrisFlyoutPresenterStyle}">
                                <ScrollViewer MaxHeight="400">
                                    <ItemsRepeater
                                        MinWidth="220"
                                        ItemTemplate="{StaticResource FilterOptionTemplate}"
                                        ItemsSource="{x:Bind ViewModel.BlockOptions, Mode=OneWay}" />
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Style="{StaticResource IrisPillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.PersonFilterText, Mode=OneWay}" />
                            <FontIcon
                                FontSize="10"
                                Glyph="&#xE70D;"
                                Style="{StaticResource IrisIconStyle}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="PersonFlyout" FlyoutPresenterStyle="{StaticResource IrisFlyoutPresenterStyle}">
                                <ScrollViewer MaxHeight="400">
                                    <ItemsRepeater
                                        MinWidth="220"
                                        ItemTemplate="{StaticResource FilterOptionTemplate}"
                                        ItemsSource="{x:Bind ViewModel.PersonOptions, Mode=OneWay}" />
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <TextBlock
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource IrisBodyEmphasizedTextStyle}"
                    Text="No hay tiempos con estos filtros"
                    Visibility="{x:Bind ViewModel.HasNoSummaryData, Mode=OneWay}" />

                <ScrollViewer
                    Grid.Row="1"
                    Padding="0,0,8,0"
                    Visibility="{x:Bind ViewModel.HasSummaryData, Mode=OneWay}">
                    <StackPanel Padding="0,0,0,24" Spacing="{StaticResource IrisSpacingXl}">
                        <ItemsRepeater ItemTemplate="{StaticResource KpiTemplate}" ItemsSource="{x:Bind ViewModel.Kpis, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MaximumRowsOrColumns="4"
                                    MinColumnSpacing="{StaticResource IrisSpacingMd}"
                                    MinItemWidth="200"
                                    MinRowSpacing="{StaticResource IrisSpacingMd}" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>

                        <StackPanel Spacing="{StaticResource IrisSpacingXs}">
                            <controls:IrisSectionHeader Title="Por persona" />
                            <Grid Padding="12,0" ColumnSpacing="{StaticResource IrisSpacingSm}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{StaticResource IrisTableNumberColumnWidth}" />
                                    <ColumnDefinition Width="{StaticResource IrisTableNumberColumnWidth}" />
                                    <ColumnDefinition Width="{StaticResource IrisTableNumberColumnWidth}" />
                                    <ColumnDefinition Width="{StaticResource IrisTableNumberColumnWidth}" />
                                    <ColumnDefinition Width="{StaticResource IrisTableNumberColumnWidth}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IrisCaptionTextStyle}" Text="Persona" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource IrisCaptionTextStyle}"
                                    Text="Participaciones" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource IrisCaptionTextStyle}"
                                    Text="Veces que se pasó" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource IrisCaptionTextStyle}"
                                    Text="Exceso promedio" />
                                <TextBlock
                                    Grid.Column="4"
                                    Style="{StaticResource IrisCaptionTextStyle}"
                                    Text="Exceso máximo" />
                                <TextBlock
                                    Grid.Column="5"
                                    Style="{StaticResource IrisCaptionTextStyle}"
                                    Text="Exceso total" />
                            </Grid>
                            <ItemsRepeater ItemTemplate="{StaticResource PersonStatTemplate}" ItemsSource="{x:Bind ViewModel.ByPerson, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="4" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>

                        <StackPanel Spacing="{StaticResource IrisSpacingXs}">
                            <controls:IrisSectionHeader Title="Por bloque" />
                            <ItemsRepeater ItemTemplate="{StaticResource BlockStatTemplate}" ItemsSource="{x:Bind ViewModel.ByBlock, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="4" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!--  ===== Sheets =====  -->
        <controls:IrisModal
            Grid.RowSpan="2"
            CloseCommand="{x:Bind ViewModel.CancelAdjustmentCommand}"
            IsOpen="{x:Bind ViewModel.IsAdjusting, Mode=OneWay}"
            PanelWidth="{StaticResource IrisConfirmModalWidth}">
            <StackPanel Padding="{StaticResource IrisPaddingXl}" Spacing="{StaticResource IrisSpacingLg}">
                <StackPanel Spacing="{StaticResource IrisSpacingXs}">
                    <TextBlock Style="{StaticResource IrisCaptionTextStyle}" Text="Ajustar duración" />
                    <TextBlock Style="{StaticResource IrisTitleTextStyle}" Text="{x:Bind ViewModel.Adjustment.Title, Mode=OneWay, FallbackValue=''}" />
                    <TextBlock Style="{StaticResource IrisCalloutTextStyle}" Text="{x:Bind ViewModel.Adjustment.Subtitle, Mode=OneWay, FallbackValue=''}" />
                </StackPanel>
                <Grid ColumnSpacing="{StaticResource IrisSpacingMd}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox
                        Header="Minutos"
                        Maximum="600"
                        Minimum="0"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.Adjustment.Minutes, Mode=TwoWay, FallbackValue=0}" />
                    <NumberBox
                        Grid.Column="1"
                        Header="Segundos"
                        Maximum="59"
                        Minimum="0"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.Adjustment.Seconds, Mode=TwoWay, FallbackValue=0}" />
                </Grid>
                <StackPanel Spacing="{StaticResource IrisSpacingSm}">
                    <Button
                        Command="{x:Bind ViewModel.AdjustDurationCommand}"
                        Content="Guardar"
                        Style="{StaticResource IrisPrimaryButtonStyle}" />
                    <Button
                        Command="{x:Bind ViewModel.CancelAdjustmentCommand}"
                        Content="Cancelar"
                        Style="{StaticResource IrisGlassButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </controls:IrisModal>

        <controls:IrisModal
            Grid.RowSpan="2"
            CloseCommand="{x:Bind ViewModel.CancelLeaderChangeCommand}"
            IsOpen="{x:Bind ViewModel.IsChangingLeader, Mode=OneWay}"
            PanelHeight="560"
            PanelWidth="{StaticResource IrisConfirmModalWidth}">
            <Grid Padding="{StaticResource IrisPaddingXl}" RowSpacing="{StaticResource IrisSpacingMd}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="{StaticResource IrisSpacingXs}">
                    <TextBlock Style="{StaticResource IrisCaptionTextStyle}" Text="Cambiar responsable" />
                    <TextBlock Style="{StaticResource IrisTitleTextStyle}" Text="{x:Bind ViewModel.LeaderSheetTitle, Mode=OneWay}" />
                </StackPanel>
                <ScrollViewer Grid.Row="1">
                    <ItemsRepeater ItemTemplate="{StaticResource LeaderChoiceTemplate}" ItemsSource="{x:Bind ViewModel.LeaderChoices, Mode=OneWay}" />
                </ScrollViewer>
                <Button
                    Grid.Row="2"
                    Command="{x:Bind ViewModel.CancelLeaderChangeCommand}"
                    Content="Cancelar"
                    Style="{StaticResource IrisGlassButtonStyle}" />
            </Grid>
        </controls:IrisModal>

        <controls:IrisModal
            Grid.RowSpan="2"
            CloseCommand="{x:Bind ViewModel.CancelDeleteCommand}"
            IsOpen="{x:Bind ViewModel.IsConfirmingDelete, Mode=OneWay}"
            PanelWidth="{StaticResource IrisConfirmModalWidth}">
            <StackPanel Padding="{StaticResource IrisPaddingXl}" Spacing="{StaticResource IrisSpacingLg}">
                <StackPanel Spacing="{StaticResource IrisSpacingXs}">
                    <TextBlock Style="{StaticResource IrisTitleTextStyle}" Text="¿Eliminar este registro?" />
                    <TextBlock Style="{StaticResource IrisCalloutTextStyle}" Text="Esta acción no se puede deshacer." />
                </StackPanel>
                <StackPanel Spacing="{StaticResource IrisSpacingSm}">
                    <Button
                        Command="{x:Bind ViewModel.DeleteSelectedCommand}"
                        Content="Eliminar"
                        Style="{StaticResource IrisDangerButtonStyle}" />
                    <Button
                        Command="{x:Bind ViewModel.CancelDeleteCommand}"
                        Content="Cancelar"
                        Style="{StaticResource IrisGlassButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </controls:IrisModal>

        <controls:IrisModal
            Grid.RowSpan="2"
            CloseCommand="{x:Bind ViewModel.CancelPickingMonthCommand}"
            IsOpen="{x:Bind ViewModel.IsPickingMonth, Mode=OneWay}"
            PanelWidth="{StaticResource IrisConfirmModalWidth}">
            <StackPanel Padding="{StaticResource IrisPaddingXl}" Spacing="{StaticResource IrisSpacingLg}">
                <TextBlock Style="{StaticResource IrisTitleTextStyle}" Text="Elegir mes" />
                <Grid ColumnSpacing="{StaticResource IrisSpacingMd}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        Header="Mes"
                        ItemsSource="{x:Bind ViewModel.MonthNames}"
                        SelectedIndex="{x:Bind ViewModel.PickedMonthIndex, Mode=TwoWay}" />
                    <ComboBox
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Header="Año"
                        ItemsSource="{x:Bind ViewModel.Years}"
                        SelectedItem="{x:Bind ViewModel.PickedYear, Mode=TwoWay}" />
                </Grid>
                <StackPanel Spacing="{StaticResource IrisSpacingSm}">
                    <Button
                        Command="{x:Bind ViewModel.ConfirmPickedMonthCommand}"
                        Content="Ver este mes"
                        Style="{StaticResource IrisPrimaryButtonStyle}" />
                    <Button
                        Command="{x:Bind ViewModel.CancelPickingMonthCommand}"
                        Content="Cancelar"
                        Style="{StaticResource IrisGlassButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </controls:IrisModal>

        <controls:IrisModal
            Grid.RowSpan="2"
            CloseCommand="{x:Bind ViewModel.ClosePersonDetailCommand}"
            IsOpen="{x:Bind ViewModel.IsShowingPersonDetail, Mode=OneWay}"
            PanelHeight="640"
            PanelWidth="{StaticResource IrisPageModalWidth}">
            <Grid Padding="{StaticResource IrisSheetPadding}" RowSpacing="{StaticResource IrisSpacingMd}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Spacing="{StaticResource IrisSpacingXs}">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource IrisTitleTextStyle}"
                            Text="{x:Bind ViewModel.PersonDetailName, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource IrisCalloutTextStyle}" Text="{x:Bind ViewModel.PersonDetailSummary, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Cerrar"
                        Command="{x:Bind ViewModel.ClosePersonDetailCommand}"
                        Style="{StaticResource IrisIconButtonStyle}"
                        ToolTipService.ToolTip="Cerrar">
                        <FontIcon Glyph="&#xE711;" Style="{StaticResource IrisIconStyle}" />
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" Padding="0,0,8,0">
                    <ItemsRepeater ItemTemplate="{StaticResource PersonBlockTemplate}" ItemsSource="{x:Bind ViewModel.PersonDetailBlocks, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>
        </controls:IrisModal>
    </Grid>
</Page>
