<!--
  Compiles the app's C# on a Mac (no XAML compiler there): every .cs of the repo plus the stubs
  xamlgen.py writes for each .xaml (x:Name fields, InitializeComponent, Bindings). Same packages as Iris.csproj.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Iris</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType><AppxGeneratePriEnabled>false</AppxGeneratePriEnabled><GenerateLibraryLayout>false</GenerateLibraryLayout><EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS8618;CS0649;CS0169;CS0414</NoWarn>
    <RepoDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../'))</RepoDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RepoDir)**/*.cs" Exclude="$(RepoDir)Tests/**;$(RepoDir)Scripts/**;$(RepoDir)obj/**;$(RepoDir)bin/**" />
    <Compile Include="obj/Generated/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>
  <Target Name="DumpRefs" AfterTargets="CoreCompile">
    <WriteLinesToFile File="$(MSBuildProjectDirectory)/obj/refs.txt" Lines="@(ReferencePath)" Overwrite="true" />
  </Target>
</Project>
