<?xml version="1.0" encoding="utf-8"?>
<!--
    Signed-in top bar (IRIS_SPEC §6.2), drawn in the window title bar:
    [‹ Inicio] · wordmark · | title / subtitle · ··· · clock · TV chip · account · caption buttons.
-->
<UserControl
    x:Class="Iris.Shell.AppTopBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Iris.DesignSystem.Controls"
    xmlns:design="using:Iris.DesignSystem"
    Height="{StaticResource IrisTopBarHeight}"
    IsTabStop="False">

    <Grid
        x:Name="Bar"
        Padding="{StaticResource IrisTopBarPadding}"
        Background="Transparent"
        ColumnSpacing="{StaticResource IrisSpacingMd}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="CaptionColumn" Width="140" />
        </Grid.ColumnDefinitions>

        <Button
            x:Name="BackButton"
            VerticalAlignment="Center"
            AutomationProperties.Name="Inicio"
            Command="{x:Bind BackCommand, Mode=OneWay}"
            Style="{StaticResource IrisPillButtonStyle}"
            ToolTipService.ToolTip="Volver al Inicio"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon
                    FontSize="{StaticResource IrisCaptionFontSize}"
                    Glyph="&#xE76B;"
                    Style="{StaticResource IrisIconStyle}" />
                <TextBlock Text="Inicio" />
            </StackPanel>
        </Button>

        <controls:IrisWordmark
            Grid.Column="1"
            VerticalAlignment="Center"
            MarkSize="{StaticResource IrisWordmarkConsoleSize}" />

        <Rectangle
            x:Name="TitleSeparator"
            Grid.Column="2"
            Style="{StaticResource IrisVerticalSeparatorStyle}"
            Visibility="Collapsed" />
        <StackPanel
            x:Name="TitleStack"
            Grid.Column="3"
            VerticalAlignment="Center"
            Spacing="2"
            Visibility="Collapsed">
            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource IrisBodyEmphasizedTextStyle}"
                TextWrapping="NoWrap" />
            <TextBlock
                x:Name="SubtitleText"
                Style="{StaticResource IrisCaptionTextStyle}"
                TextWrapping="NoWrap"
                Visibility="Collapsed" />
        </StackPanel>

        <!--  Sync indicator: state at a glance, details and "Actualizar ahora" in the flyout  -->
        <Button
            x:Name="SyncChip"
            Grid.Column="5"
            VerticalAlignment="Center"
            AutomationProperties.Name="Sincronización"
            Style="{StaticResource IrisPillButtonStyle}"
            ToolTipService.ToolTip="Estado de la sincronización"
            Visibility="{x:Bind Sync.IsVisible, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon
                    FontSize="{StaticResource IrisCaptionFontSize}"
                    Foreground="{x:Bind design:IrisTheme.SyncToneBrush(Sync.IsOffline, Sync.IsFailed), Mode=OneWay}"
                    Glyph="&#xE895;"
                    Style="{StaticResource IrisIconStyle}" />
                <TextBlock
                    Foreground="{x:Bind design:IrisTheme.SyncToneBrush(Sync.IsOffline, Sync.IsFailed), Mode=OneWay}"
                    Text="{x:Bind Sync.Headline, Mode=OneWay}" />
            </StackPanel>
            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterStyle="{StaticResource IrisFlyoutPresenterStyle}">
                    <StackPanel Width="{StaticResource IrisSyncFlyoutWidth}" Spacing="{StaticResource IrisSpacingSm}">
                        <TextBlock Style="{StaticResource IrisBodyEmphasizedTextStyle}" Text="{x:Bind Sync.Headline, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource IrisCalloutTextStyle}" Text="{x:Bind Sync.LastSyncText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource IrisCalloutTextStyle}" Text="{x:Bind Sync.PendingText, Mode=OneWay}" />
                        <controls:IrisBanner Message="{x:Bind Sync.FailureText, Mode=OneWay}" />
                        <controls:IrisBanner Kind="Info" Message="{x:Bind Sync.DiskWarning, Mode=OneWay}" />
                        <ItemsControl ItemsSource="{x:Bind Sync.Notices, Mode=OneWay}" Visibility="{x:Bind Sync.HasNotices, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Style="{StaticResource IrisCaptionTextStyle}" Text="{x:Bind}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button
                            HorizontalAlignment="Left"
                            Command="{x:Bind Sync.DismissNoticesCommand}"
                            Content="Descartar avisos"
                            Style="{StaticResource IrisLinkButtonStyle}"
                            Visibility="{x:Bind Sync.HasNotices, Mode=OneWay}" />
                        <Button
                            Command="{x:Bind Sync.SyncNowCommand}"
                            Content="Actualizar ahora"
                            IsEnabled="{x:Bind Sync.CanSyncNow, Mode=OneWay}"
                            Style="{StaticResource IrisGlassButtonStyle}" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>

        <TextBlock
            Grid.Column="6"
            VerticalAlignment="Center"
            AutomationProperties.Name="Hora"
            Style="{StaticResource IrisClockTextStyle}"
            Text="{x:Bind ViewModel.ClockText, Mode=OneWay}" />

        <Border
            x:Name="DisplayChip"
            Grid.Column="7"
            Padding="12,6,14,6"
            VerticalAlignment="Center"
            Style="{StaticResource IrisGlassCapsuleStyle}"
            Tapped="OnDisplayChipTapped"
            ToolTipService.ToolTip="{x:Bind ViewModel.DisplayTooltip, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon
                    VerticalAlignment="Center"
                    Foreground="{x:Bind design:IrisTheme.DisplayStatusBrush(ViewModel.IsDisplayConnected), Mode=OneWay}"
                    Glyph="&#xE7F4;"
                    Style="{StaticResource IrisIconStyle}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{StaticResource IrisTextPrimaryBrush}"
                        Style="{StaticResource IrisCaptionTextStyle}"
                        Text="{x:Bind ViewModel.DisplayTitle, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource IrisCaptionTextStyle}" Text="{x:Bind ViewModel.DisplayDetail, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Button
            x:Name="AccountButton"
            Grid.Column="8"
            Width="{StaticResource IrisAvatarSize}"
            Height="{StaticResource IrisAvatarSize}"
            Padding="0"
            VerticalAlignment="Center"
            AutomationProperties.Name="Cuenta"
            Background="{StaticResource IrisAccentGradientBrush}"
            BorderBrush="{StaticResource IrisPrimaryButtonOverlayBrush}"
            BorderThickness="{StaticResource IrisHairline}"
            CornerRadius="{StaticResource IrisRadiusCapsuleAvatar}"
            FontWeight="Bold"
            Foreground="{StaticResource IrisTextInverseBrush}"
            Style="{StaticResource IrisButtonBaseStyle}"
            ToolTipService.ToolTip="Cuenta">
            <TextBlock FontSize="{StaticResource IrisCalloutFontSize}" Text="{x:Bind ViewModel.AccountInitials, Mode=OneWay}" />
            <Button.Flyout>
                <MenuFlyout Opening="OnAccountFlyoutOpening" Placement="BottomEdgeAlignedRight">
                    <MenuFlyoutItem IsEnabled="False" Text="{x:Bind ViewModel.FullName, Mode=OneWay}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE77B;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem IsEnabled="False" Text="{x:Bind ViewModel.Email, Mode=OneWay}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE715;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem IsEnabled="False" Text="{x:Bind ViewModel.AccountSummary, Mode=OneWay}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE825;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem x:Name="ChurchSwitchItem" Text="Cambiar de iglesia">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon Glyph="&#xE8AB;" />
                        </MenuFlyoutSubItem.Icon>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator x:Name="ChurchSwitchSeparator" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.SignOutCommand}" Text="Cerrar sesión">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xF3B1;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        Command="{x:Bind ViewModel.SignOutAllCommand}"
                        Foreground="{StaticResource IrisDangerBrush}"
                        Text="Cerrar sesión en todos los dispositivos">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Foreground="{StaticResource IrisDangerBrush}" Glyph="&#xE7E8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem IsEnabled="False" Text="El equipo se administra desde la web." />
                </MenuFlyout>
            </Button.Flyout>
        </Button>
    </Grid>
</UserControl>
