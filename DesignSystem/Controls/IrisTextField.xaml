<?xml version="1.0" encoding="utf-8"?>
<!--  Labeled text field (IRIS_SPEC §5.3): icon, focus gradient border, error or hint below.  -->
<UserControl
    x:Class="Iris.DesignSystem.Controls.IrisTextField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <UserControl.Resources>
        <!--  Lightweight styling: the inner TextBox/PasswordBox draw no chrome; the container does.  -->
        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
        <StaticResource x:Key="TextControlForeground" ResourceKey="IrisTextPrimaryBrush" />
        <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="IrisTextPrimaryBrush" />
        <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="IrisTextPrimaryBrush" />
        <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="IrisTextTertiaryBrush" />
        <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="IrisTextTertiaryBrush" />
        <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="IrisTextTertiaryBrush" />
        <StaticResource x:Key="TextControlButtonForeground" ResourceKey="IrisTextSecondaryBrush" />
        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
    </UserControl.Resources>

    <StackPanel Spacing="{StaticResource IrisSpacingXs}">
        <TextBlock
            x:Name="LabelText"
            Style="{StaticResource IrisLabelTextStyle}"
            Visibility="Collapsed" />

        <Border
            x:Name="Container"
            Height="{StaticResource IrisControlHeight}"
            Padding="{StaticResource IrisFieldPadding}"
            Background="{StaticResource IrisSurfaceBrush}"
            BorderBrush="{StaticResource IrisStrokeBrush}"
            BorderThickness="{StaticResource IrisHairline}"
            CornerRadius="{StaticResource IrisRadiusMd}">
            <Grid ColumnSpacing="{StaticResource IrisSpacingXs}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource IrisFieldIconColumnWidth}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    x:Name="Icon"
                    FontSize="{StaticResource IrisIconFontSize}"
                    Foreground="{StaticResource IrisTextTertiaryBrush}"
                    Style="{StaticResource IrisIconStyle}" />

                <TextBox
                    x:Name="Input"
                    Grid.Column="1"
                    MinHeight="0"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    FontFamily="{StaticResource IrisSansFontFamily}"
                    FontSize="{StaticResource IrisBodyFontSize}"
                    GotFocus="OnInputGotFocus"
                    KeyDown="OnInputKeyDown"
                    LostFocus="OnInputLostFocus"
                    PlaceholderForeground="{StaticResource IrisTextTertiaryBrush}"
                    SelectionHighlightColor="{StaticResource IrisCoralBrush}"
                    TextChanged="OnTextChanged" />

                <PasswordBox
                    x:Name="SecretInput"
                    Grid.Column="1"
                    MinHeight="0"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    FontFamily="{StaticResource IrisSansFontFamily}"
                    FontSize="{StaticResource IrisBodyFontSize}"
                    GotFocus="OnInputGotFocus"
                    KeyDown="OnInputKeyDown"
                    LostFocus="OnInputLostFocus"
                    PasswordChanged="OnPasswordChanged"
                    PasswordRevealMode="Hidden"
                    SelectionHighlightColor="{StaticResource IrisCoralBrush}"
                    Visibility="Collapsed" />

                <Button
                    x:Name="RevealButton"
                    Grid.Column="2"
                    Click="OnRevealClick"
                    IsTabStop="False"
                    Style="{StaticResource IrisSubtleIconButtonStyle}"
                    Visibility="Collapsed">
                    <FontIcon x:Name="RevealIcon" Style="{StaticResource IrisIconStyle}" />
                </Button>
            </Grid>
        </Border>

        <StackPanel
            x:Name="ErrorRow"
            Orientation="Horizontal"
            Spacing="6"
            Visibility="Collapsed">
            <FontIcon
                FontSize="{StaticResource IrisCaptionFontSize}"
                Foreground="{StaticResource IrisDangerBrush}"
                Glyph="&#xEA39;"
                Style="{StaticResource IrisIconStyle}" />
            <TextBlock
                x:Name="ErrorText"
                Foreground="{StaticResource IrisDangerBrush}"
                Style="{StaticResource IrisCaptionTextStyle}" />
        </StackPanel>

        <TextBlock
            x:Name="HintText"
            Style="{StaticResource IrisCaptionTextStyle}"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
