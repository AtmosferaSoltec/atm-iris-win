<?xml version="1.0" encoding="utf-8"?>
<!--
    Iris design tokens (IRIS_SPEC §4). Dark-only palette: "luz que atraviesa un vitral".
    Views never use literal colors, sizes or radii; they reference these keys.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ===== Color (IrisColor) =====  -->
    <Color x:Key="IrisCanvasColor">#FF07070B</Color>
    <Color x:Key="IrisCanvasElevatedColor">#FF0E0E15</Color>
    <Color x:Key="IrisSurfaceColor">#0DFFFFFF</Color>
    <Color x:Key="IrisSurfaceRaisedColor">#14FFFFFF</Color>
    <Color x:Key="IrisStrokeColor">#17FFFFFF</Color>
    <Color x:Key="IrisStrokeStrongColor">#2EFFFFFF</Color>
    <Color x:Key="IrisTextPrimaryColor">#FFF6F3EE</Color>
    <Color x:Key="IrisTextSecondaryColor">#A3F6F3EE</Color>
    <Color x:Key="IrisTextTertiaryColor">#66F6F3EE</Color>
    <Color x:Key="IrisTextInverseColor">#FF120D0A</Color>
    <Color x:Key="IrisEmberColor">#FFFFB547</Color>
    <Color x:Key="IrisCoralColor">#FFFF7A59</Color>
    <Color x:Key="IrisRoseColor">#FFF0508C</Color>
    <Color x:Key="IrisVioletColor">#FF9B5CFF</Color>
    <Color x:Key="IrisIndigoColor">#FF4E5BFF</Color>
    <Color x:Key="IrisGlowVioletColor">#FF2A1658</Color>
    <Color x:Key="IrisGlowIndigoColor">#FF131E5C</Color>
    <Color x:Key="IrisGlowRoseColor">#FF3D1235</Color>
    <Color x:Key="IrisGlowEmberColor">#FF3A1E08</Color>
    <Color x:Key="IrisSuccessColor">#FF3DDC97</Color>
    <Color x:Key="IrisWarningColor">#FFFFC857</Color>
    <Color x:Key="IrisDangerColor">#FFFF5C7A</Color>
    <Color x:Key="IrisLiveColor">#FFFF3B5C</Color>
    <Color x:Key="IrisScrimColor">#99000000</Color>

    <!--  Brushes  -->
    <SolidColorBrush x:Key="IrisCanvasBrush" Color="{StaticResource IrisCanvasColor}" />
    <SolidColorBrush x:Key="IrisCanvasElevatedBrush" Color="{StaticResource IrisCanvasElevatedColor}" />
    <SolidColorBrush x:Key="IrisSurfaceBrush" Color="{StaticResource IrisSurfaceColor}" />
    <SolidColorBrush x:Key="IrisSurfaceRaisedBrush" Color="{StaticResource IrisSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="IrisStrokeBrush" Color="{StaticResource IrisStrokeColor}" />
    <SolidColorBrush x:Key="IrisStrokeStrongBrush" Color="{StaticResource IrisStrokeStrongColor}" />
    <SolidColorBrush x:Key="IrisTextPrimaryBrush" Color="{StaticResource IrisTextPrimaryColor}" />
    <SolidColorBrush x:Key="IrisTextSecondaryBrush" Color="{StaticResource IrisTextSecondaryColor}" />
    <SolidColorBrush x:Key="IrisTextTertiaryBrush" Color="{StaticResource IrisTextTertiaryColor}" />
    <SolidColorBrush x:Key="IrisTextInverseBrush" Color="{StaticResource IrisTextInverseColor}" />
    <SolidColorBrush x:Key="IrisEmberBrush" Color="{StaticResource IrisEmberColor}" />
    <SolidColorBrush x:Key="IrisCoralBrush" Color="{StaticResource IrisCoralColor}" />
    <SolidColorBrush x:Key="IrisRoseBrush" Color="{StaticResource IrisRoseColor}" />
    <SolidColorBrush x:Key="IrisVioletBrush" Color="{StaticResource IrisVioletColor}" />
    <SolidColorBrush x:Key="IrisIndigoBrush" Color="{StaticResource IrisIndigoColor}" />
    <SolidColorBrush x:Key="IrisSuccessBrush" Color="{StaticResource IrisSuccessColor}" />
    <SolidColorBrush x:Key="IrisWarningBrush" Color="{StaticResource IrisWarningColor}" />
    <SolidColorBrush x:Key="IrisDangerBrush" Color="{StaticResource IrisDangerColor}" />
    <SolidColorBrush x:Key="IrisLiveBrush" Color="{StaticResource IrisLiveColor}" />
    <SolidColorBrush x:Key="IrisScrimBrush" Color="{StaticResource IrisScrimColor}" />
    <SolidColorBrush x:Key="IrisBlackBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="IrisCheckOffBrush" Color="#40000000" />
    <SolidColorBrush x:Key="IrisSelectionRingBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="IrisPrimaryButtonOverlayBrush" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="IrisDangerTintBrush" Color="{StaticResource IrisDangerColor}" Opacity="0.8" />
    <SolidColorBrush x:Key="IrisCoralGlowBrush" Color="{StaticResource IrisCoralColor}" Opacity="0.22" />

    <!--  ===== Gradients (IrisGradient) =====  -->
    <LinearGradientBrush x:Key="IrisAccentGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="{StaticResource IrisEmberColor}" />
        <GradientStop Offset="0.5" Color="{StaticResource IrisCoralColor}" />
        <GradientStop Offset="1" Color="{StaticResource IrisRoseColor}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IrisSpectrumGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="{StaticResource IrisEmberColor}" />
        <GradientStop Offset="0.25" Color="{StaticResource IrisCoralColor}" />
        <GradientStop Offset="0.5" Color="{StaticResource IrisRoseColor}" />
        <GradientStop Offset="0.75" Color="{StaticResource IrisVioletColor}" />
        <GradientStop Offset="1" Color="{StaticResource IrisIndigoColor}" />
    </LinearGradientBrush>
    <!--  Panel border: vertical white 16% -> 3%  -->
    <LinearGradientBrush x:Key="IrisSurfaceBorderBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0" Color="#29FFFFFF" />
        <GradientStop Offset="1" Color="#08FFFFFF" />
    </LinearGradientBrush>

    <!--  ===== Materials =====  -->
    <!--  Panels: ultra-thin material + canvasElevated @ 72%  -->
    <AcrylicBrush
        x:Key="IrisPanelMaterialBrush"
        FallbackColor="{StaticResource IrisCanvasElevatedColor}"
        TintColor="{StaticResource IrisCanvasElevatedColor}"
        TintOpacity="0.72"
        TintLuminosityOpacity="0.85" />
    <!--  Floating controls (Liquid Glass equivalent)  -->
    <AcrylicBrush
        x:Key="IrisGlassBrush"
        FallbackColor="#FF1A1A23"
        TintColor="{StaticResource IrisCanvasElevatedColor}"
        TintOpacity="0.45"
        TintLuminosityOpacity="0.6" />
    <SolidColorBrush x:Key="IrisGlassHoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="IrisGlassActiveBrush" Color="{StaticResource IrisCoralColor}" Opacity="0.92" />

    <!--  ===== Typography (IrisFont) =====  -->
    <FontFamily x:Key="IrisSerifDisplayFontFamily">Sitka Display, Georgia</FontFamily>
    <FontFamily x:Key="IrisSerifTextFontFamily">Sitka Text, Georgia</FontFamily>
    <FontFamily x:Key="IrisSansFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IrisSansDisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IrisIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <x:Double x:Key="IrisDisplayFontSize">56</x:Double>
    <x:Double x:Key="IrisHeadlineFontSize">34</x:Double>
    <x:Double x:Key="IrisTitleFontSize">28</x:Double>
    <x:Double x:Key="IrisProjectionFontSize">26</x:Double>
    <x:Double x:Key="IrisSubtitleFontSize">18</x:Double>
    <x:Double x:Key="IrisClockFontSize">20</x:Double>
    <x:Double x:Key="IrisBodyFontSize">15</x:Double>
    <x:Double x:Key="IrisCalloutFontSize">14</x:Double>
    <x:Double x:Key="IrisLabelFontSize">13</x:Double>
    <x:Double x:Key="IrisCaptionFontSize">12</x:Double>
    <x:Double x:Key="IrisOverlineFontSize">11</x:Double>
    <x:Double x:Key="IrisIconFontSize">16</x:Double>
    <x:Double x:Key="IrisIconSmallFontSize">14</x:Double>
    <x:Double x:Key="IrisIconLargeFontSize">28</x:Double>
    <x:Double x:Key="IrisNumberCellFontSize">20</x:Double>

    <!--  Tracking (IrisTracking) in 1/1000 em: tight -0.5pt, overline 2.0pt, caps 1.2pt  -->
    <x:Int32 x:Key="IrisTrackingTight">-12</x:Int32>
    <x:Int32 x:Key="IrisTrackingOverline">180</x:Int32>
    <x:Int32 x:Key="IrisTrackingCaps">110</x:Int32>

    <!--  ===== Spacing (IrisSpacing) =====  -->
    <x:Double x:Key="IrisSpacingXxs">4</x:Double>
    <x:Double x:Key="IrisSpacingXs">8</x:Double>
    <x:Double x:Key="IrisSpacingSm">12</x:Double>
    <x:Double x:Key="IrisSpacingMd">16</x:Double>
    <x:Double x:Key="IrisSpacingLg">24</x:Double>
    <x:Double x:Key="IrisSpacingXl">32</x:Double>
    <x:Double x:Key="IrisSpacingXxl">48</x:Double>
    <x:Double x:Key="IrisSpacingXxxl">64</x:Double>

    <Thickness x:Key="IrisPaddingXs">8</Thickness>
    <Thickness x:Key="IrisPaddingSm">12</Thickness>
    <Thickness x:Key="IrisPaddingMd">16</Thickness>
    <Thickness x:Key="IrisPaddingLg">24</Thickness>
    <Thickness x:Key="IrisPaddingXl">32</Thickness>
    <Thickness x:Key="IrisPaddingXxl">48</Thickness>
    <Thickness x:Key="IrisAuthPagePadding">64,48,64,48</Thickness>
    <Thickness x:Key="IrisAuthPageCompactPadding">24,64,24,32</Thickness>
    <Thickness x:Key="IrisTopBarPadding">24,0,0,0</Thickness>
    <Thickness x:Key="IrisConsoleBodyPadding">16,0,16,16</Thickness>
    <Thickness x:Key="IrisRowPadding">12,10,12,10</Thickness>
    <Thickness x:Key="IrisFieldPadding">12,0,8,0</Thickness>
    <Thickness x:Key="IrisPillPadding">14,0,14,0</Thickness>
    <Thickness x:Key="IrisChipPadding">10,4,10,4</Thickness>
    <Thickness x:Key="IrisToastPadding">20,0,8,0</Thickness>
    <Thickness x:Key="IrisHairline">1</Thickness>
    <Thickness x:Key="IrisFocusStroke">1.5</Thickness>
    <Thickness x:Key="IrisSelectedCardStroke">3</Thickness>
    <Thickness x:Key="IrisSelectionRingStroke">2</Thickness>
    <Thickness x:Key="IrisNoThickness">0</Thickness>

    <!--  ===== Radii (IrisRadius) =====  -->
    <CornerRadius x:Key="IrisRadiusSm">10</CornerRadius>
    <CornerRadius x:Key="IrisRadiusMd">16</CornerRadius>
    <CornerRadius x:Key="IrisRadiusLg">22</CornerRadius>
    <CornerRadius x:Key="IrisRadiusXl">28</CornerRadius>
    <CornerRadius x:Key="IrisRadiusXxl">36</CornerRadius>
    <CornerRadius x:Key="IrisRadiusSwatch">8</CornerRadius>
    <!--  Capsules: WinUI clamps radii per axis, so each capsule height gets its exact half-height radius.  -->
    <CornerRadius x:Key="IrisRadiusCapsule">22</CornerRadius>
    <CornerRadius x:Key="IrisRadiusCapsuleTrack">23</CornerRadius>
    <CornerRadius x:Key="IrisRadiusCapsuleSegment">18</CornerRadius>
    <CornerRadius x:Key="IrisRadiusCapsulePill">16</CornerRadius>
    <CornerRadius x:Key="IrisRadiusCapsuleToast">26</CornerRadius>
    <CornerRadius x:Key="IrisRadiusCapsuleBadge">13</CornerRadius>
    <CornerRadius x:Key="IrisRadiusCapsuleChip">12</CornerRadius>
    <CornerRadius x:Key="IrisRadiusCapsuleTag">10</CornerRadius>
    <CornerRadius x:Key="IrisRadiusSelectionBar">2</CornerRadius>

    <!--  ===== Sizes (IrisSize) =====  -->
    <x:Double x:Key="IrisControlHeight">44</x:Double>
    <x:Double x:Key="IrisSegmentHeight">36</x:Double>
    <x:Double x:Key="IrisIconButtonSize">36</x:Double>
    <x:Double x:Key="IrisPillHeight">32</x:Double>
    <x:Double x:Key="IrisAuthPanelWidth">480</x:Double>
    <x:Double x:Key="IrisReadableWidth">560</x:Double>
    <x:Double x:Key="IrisTopBarHeight">68</x:Double>
    <x:Double x:Key="IrisAvatarSize">42</x:Double>
    <x:Double x:Key="IrisRowIconSize">36</x:Double>
    <x:Double x:Key="IrisFieldIconWidth">22</x:Double>
    <x:Double x:Key="IrisCheckmarkSize">24</x:Double>
    <x:Double x:Key="IrisLiveDotSize">7</x:Double>
    <x:Double x:Key="IrisEmblemSize">64</x:Double>
    <x:Double x:Key="IrisToastHeight">52</x:Double>
    <x:Double x:Key="IrisMiniTvMaxWidth">440</x:Double>
    <x:Double x:Key="IrisMediaStageMaxWidth">640</x:Double>
    <x:Double x:Key="IrisMediaStageButtonWidth">300</x:Double>
    <x:Double x:Key="IrisAddButtonWidth">260</x:Double>
    <x:Double x:Key="IrisSlideCardMinWidth">220</x:Double>
    <x:Double x:Key="IrisLibraryTileMinWidth">200</x:Double>
    <x:Double x:Key="IrisBookCellMinWidth">150</x:Double>
    <x:Double x:Key="IrisNumberCellMinWidth">64</x:Double>
    <x:Double x:Key="IrisNumberCellHeight">56</x:Double>
    <x:Double x:Key="IrisSwatchWidth">92</x:Double>
    <x:Double x:Key="IrisSwatchHeight">52</x:Double>
    <x:Double x:Key="IrisSwatchCellWidth">100</x:Double>
    <x:Double x:Key="IrisFormModalWidth">620</x:Double>
    <x:Double x:Key="IrisPageModalWidth">900</x:Double>
    <x:Double x:Key="IrisConfirmModalWidth">420</x:Double>
    <x:Double x:Key="IrisSelectionBarWidth">3</x:Double>
    <x:Double x:Key="IrisSeparatorHeight">28</x:Double>
    <x:Double x:Key="IrisHairlineSize">1</x:Double>
    <x:Double x:Key="IrisWordmarkConsoleSize">24</x:Double>
    <x:Double x:Key="IrisWordmarkAuthSize">30</x:Double>
    <x:Double x:Key="IrisDisabledOpacity">0.45</x:Double>
    <x:Double x:Key="IrisPressedOpacity">0.85</x:Double>
    <x:Double x:Key="IrisFootnoteOpacity">0.6</x:Double>
    <GridLength x:Key="IrisColumnWidthWide">340</GridLength>
    <GridLength x:Key="IrisColumnWidthNarrow">300</GridLength>
    <GridLength x:Key="IrisFieldIconColumnWidth">22</GridLength>
    <GridLength x:Key="IrisTopBarRowHeight">68</GridLength>
    <!--  Church screens (Home, Modules, People, Services, Times) and block timer  -->
    <x:Double x:Key="IrisContentWidth">1280</x:Double>
    <x:Double x:Key="IrisSettingsColumnWidth">720</x:Double>
    <x:Double x:Key="IrisGreetingFontSize">44</x:Double>
    <x:Double x:Key="IrisHeroTitleFontSize">52</x:Double>
    <x:Double x:Key="IrisMetricFontSize">20</x:Double>
    <x:Double x:Key="IrisTimerClockFontSize">26</x:Double>
    <x:Double x:Key="IrisHeroMarkSize">520</x:Double>
    <x:Double x:Key="IrisHeroMarkOpacity">0.2</x:Double>
    <x:Double x:Key="IrisHeroSideWidth">380</x:Double>
    <x:Double x:Key="IrisHeroButtonWidth">280</x:Double>
    <x:Double x:Key="IrisNewServiceButtonWidth">240</x:Double>
    <x:Double x:Key="IrisSaveButtonWidth">180</x:Double>
    <x:Double x:Key="IrisNextBlockButtonWidth">220</x:Double>
    <x:Double x:Key="IrisStartBlocksButtonWidth">200</x:Double>
    <x:Double x:Key="IrisSettingsIconSize">40</x:Double>
    <x:Double x:Key="IrisAvatarRowSize">40</x:Double>
    <x:Double x:Key="IrisColorSwatchSize">36</x:Double>
    <x:Double x:Key="IrisStatusDotSize">8</x:Double>
    <x:Double x:Key="IrisServiceStripeHeight">4</x:Double>
    <x:Double x:Key="IrisProgressBarHeight">4</x:Double>
    <x:Double x:Key="IrisServiceCardMinWidth">320</x:Double>
    <x:Double x:Key="IrisRecordListWidth">380</x:Double>
    <x:Double x:Key="IrisMinutesBoxWidth">140</x:Double>
    <x:Double x:Key="IrisLeaderMenuWidth">200</x:Double>
    <GridLength x:Key="IrisRecordListColumnWidth">380</GridLength>
    <GridLength x:Key="IrisHeroSideColumnWidth">380</GridLength>
    <GridLength x:Key="IrisTableNumberColumnWidth">120</GridLength>
    <CornerRadius x:Key="IrisRadiusCapsuleAvatar">21</CornerRadius>
    <CornerRadius x:Key="IrisRadiusCapsuleSwatch">18</CornerRadius>
    <CornerRadius x:Key="IrisRadiusCapsuleDot">4</CornerRadius>
    <CornerRadius x:Key="IrisRadiusStripe">2</CornerRadius>
    <Thickness x:Key="IrisPagePadding">32,8,32,32</Thickness>
    <Thickness x:Key="IrisHeroPadding">40</Thickness>
    <Thickness x:Key="IrisSheetPadding">24</Thickness>
    <!--  Centers a 32px pill on a labeled 44px field (label 17 + spacing 8 + 6).  -->
    <Thickness x:Key="IrisFieldPillOffset">0,31,0,0</Thickness>
    <Thickness x:Key="IrisTimerBarPadding">16</Thickness>
    <Thickness x:Key="IrisDividerThickness">0,0,0,1</Thickness>
    <Thickness x:Key="IrisTopDividerThickness">0,1,0,0</Thickness>
    <x:Double x:Key="IrisAuthWideBreakpoint">1000</x:Double>
    <x:Double x:Key="IrisConsoleWideBreakpoint">1400</x:Double>
</ResourceDictionary>
