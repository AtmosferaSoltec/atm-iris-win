<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Iris.Views.Auth.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24" MinHeight="560">
            <Border
                MaxWidth="400"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Padding="32"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">

                <StackPanel Spacing="16">
                    <!-- Brand -->
                    <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Border
                            Width="64"
                            Height="64"
                            HorizontalAlignment="Center"
                            CornerRadius="32"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon
                                Glyph="&#xE7F4;"
                                FontSize="28"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock
                            Text="Bienvenido a Iris"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Text="Inicia sesión para continuar"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}" />
                    </StackPanel>

                    <!-- Form -->
                    <TextBox
                        Header="Usuario o correo"
                        PlaceholderText="nombre@iglesia.org"
                        Text="{x:Bind ViewModel.UserName, Mode=TwoWay}" />

                    <PasswordBox
                        Header="Contraseña"
                        PlaceholderText="••••••••"
                        Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />

                    <Grid>
                        <CheckBox Content="Recordarme" IsChecked="{x:Bind ViewModel.RememberMe, Mode=TwoWay}" />
                        <HyperlinkButton
                            Content="¿Olvidaste tu contraseña?"
                            HorizontalAlignment="Right"
                            Padding="4" />
                    </Grid>

                    <Button
                        Content="Iniciar sesión"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SignInCommand}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                        <TextBlock
                            Text="¿No tienes cuenta?"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton
                            Content="Regístrate"
                            Padding="4"
                            Command="{x:Bind ViewModel.GoToRegisterCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
