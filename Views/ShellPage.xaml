<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Iris.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView
        x:Name="NavView"
        PaneDisplayMode="Left"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="True"
        OpenPaneLength="240"
        SelectionChanged="NavView_SelectionChanged">

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Inicio" Tag="Dashboard" IsSelected="True">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE80F;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemSeparator />
            <NavigationViewItemHeader Content="Proyección" />
            <NavigationViewItem Content="Canciones" Tag="Songs">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8D6;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Biblia" Tag="Bible">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE82D;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Fondos" Tag="Backgrounds">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE91B;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemHeader Content="Audio" />
            <NavigationViewItem Content="Música" Tag="Media">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE93C;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Configuración" Tag="Settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Command bar: section title, live indicator, projection toggle, user menu -->
            <Grid Padding="24,12,24,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="{x:Bind ViewModel.CurrentSection, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}" />

                <Border
                    Grid.Column="1"
                    Padding="10,4"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Background="{ThemeResource SystemFillColorCriticalBrush}"
                    Visibility="{x:Bind ViewModel.IsProjecting, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock
                            Text="EN VIVO"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>

                <ToggleButton
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    IsChecked="{x:Bind ViewModel.IsProjecting, Mode=TwoWay}"
                    ToolTipService.ToolTip="Abrir o cerrar la pantalla de proyección">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                        <TextBlock Text="Proyectar" />
                    </StackPanel>
                </ToggleButton>

                <DropDownButton Grid.Column="3" VerticalAlignment="Center" Padding="4,4,8,4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PersonPicture Width="28" Height="28" Initials="{x:Bind ViewModel.UserInitials}" />
                        <TextBlock Text="{x:Bind ViewModel.UserName}" VerticalAlignment="Center" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Mi perfil">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE77B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Cerrar sesión" Command="{x:Bind ViewModel.SignOutCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xF3B1;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>

            <!-- Content area: section pages will be hosted here in the next step -->
            <Grid Grid.Row="1" Margin="24,0,24,24">
                <Frame x:Name="ContentFrame" />
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <FontIcon
                        Glyph="&#xE9F5;"
                        FontSize="48"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        Text="Sección en construcción"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="Esta pantalla se maquetará en el siguiente paso."
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Grid>
    </NavigationView>
</Page>
